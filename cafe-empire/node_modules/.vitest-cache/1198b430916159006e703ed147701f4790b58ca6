ult) => void; toast: (m: string) => void; refresh: () => void; show: () => void; go: (tab: string) => void; exit: () => void; wipe: () => void; save: () => void }\n\nexport const NAV: Array<[string, string, string]> = [['ana', '🏠', 'Merkez'], ['harita', '🗺️', 'Türkiye'], ['subeler', '🏪', 'Dükkânlar'], ['stok', '📦', 'Stok'], ['tedarik', '🚚', 'Tedarikçiler'], ['merkez', '🏭', 'Merkezi depo'], ['sosyal', '📸', 'Sosyal medya'], ['reklam', '📣', 'Reklam'], ['kampanya', '🏷️', 'Kampanyalar'], ['online', '🛵', 'Teslimat'], ['prestij', '⭐', 'İtibar'], ['hedefler', '🎯', 'Hedefler'], ['iller', '🏙️', 'İller'], ['franchise', '🤝', 'Franchise'], ['siralama', '🥇', 'Liderlik'], ['banka', '🏦', 'Bankalar'], ['finans', '💰', 'Gelir-gider'], ['ekonomi', '📈', 'Ekonomi'], ['rapor', '📊', 'Raporlar'], ['musteri', '🙂', 'Müşteriler'], ['ayar', '⚙️', 'Ayarlar'],\n  ['menu', '📋', 'Menü ve fiyat'], ['personel', '👥', 'Personel'], ['vardiya', '🗓️', 'Vardiya'], ['gelisim', '🛠️', 'Ekipman'], ['genel', '🏠', 'Genel Bakış'],\n  ['cek', '🫘', 'Çekirdek ve kavurma'], ['tarif', '🧪', 'Tarif atölyesi'], ['usta', '🎓', 'Barista ustalığı'], ['fuar', '🏆', 'Kahve fuarı'], ['takvim', '📅', 'Semt takvimi'], ['mudavim', '☕', 'Müdavimler'], ['esnaf', '🤝', 'Komşu esnaf'], ['rakipler', '🏢', 'Rakip zincirler'], ['hikaye', '📖', 'Dükkân hikâyesi'], ['tedil', '🚛', 'Tedarikçi ilişkisi'], ['yorumlar', '💬', 'Yorumlar'], ['grafik', '📊', 'İstatistikler'], ['donem', '🎯', 'Meydan okumalar'], ['kariyer', '🏅', 'Kariyer özeti'], ['sezon', '🍂', 'Sezon ve menü'], ['yatirim', '💼', 'Yatırımcılar'], ['kavurmahane', '🔥', 'Kavurmahane'], ['kurye', '🛵', 'Kurye ve bulut'], ['mulk', '🏠', 'Mülkler'], ['sadakat', '📱', 'Sadakat uygulaması'], ['basin', '📰', 'Basın ve imaj'], ['anket', '📋', 'Anket ve A/B'], ['mevzuat', '⚖️', 'Mevzuat ve devlet'], ['surdur', '🌿', 'Sürdürülebilirlik'], ['sigorta', '🛡️', 'Sigorta ve afet']];\n/** Alt menü: 8 sekme; sekme içindeki sayfalar üstte çip olur. */\nexport interface Grup { id: string; ik: string; ad: string; renk: string; tabs: string[] }\nexport const GRUPLAR: Grup[] = [\n  { id: 'ana', ik: '🏠', ad: 'Merkez', renk: '#ff8a4c', tabs: ['ana'] },\n  { id: 'harita', ik: '🗺️', ad: 'Türkiye', renk: '#5fb3ff', tabs: ['harita'] },\n  { id: 'subeler', ik: '🏪', ad: 'Dükkânlar', renk: '#ffb44c', tabs: ['subeler', 'mulk', 'yorumlar', 'musteri'] },\n  { id: 'atolye', ik: '☕', ad: 'Atölye', renk: '#d9a066', tabs: ['cek', 'tarif', 'sezon', 'kavurmahane', 'usta', 'fuar'] },\n  { id: 'semt', ik: '🏘️', ad: 'Semt', renk: '#7fd0c7', tabs: ['takvim', 'mudavim', 'esnaf', 'rakipler', 'hikaye'] },\n  { id: 'depo', ik: '📦', ad: 'Depo', renk: '#4fd1a5', tabs: ['stok', 'tedarik', 'tedil', 'merkez'] },\n  { id: 'tanitim', ik: '📣', ad: 'Tanıtım', renk: '#ff7aa8', tabs: ['sosyal', 'reklam', 'kampanya', 'online', 'kurye', 'sadakat', 'basin', 'anket'] },\n  { id: 'gelisim', ik: '🚀', ad: 'Gelişim', renk: '#b07cff', tabs: ['prestij', 'hedefler', 'donem', 'kariyer', 'surdur', 'iller', 'franchise', 'siralama'] },\n  { id: 'kasa', ik: '💰', ad: 'Kasa', renk: '#4fd1a5', tabs: ['banka', 'yatirim', 'mevzuat', 'sigorta', 'finans', 'ekonomi', 'grafik', 'rapor'] },\n  { id: 'ayar', ik: '⚙️', ad: 'Ayarlar', renk: '#9aa8b0', tabs: ['ayar'] },\n];\n/** Menü gruplarında kendi çipi olmayan ama dükkân detayında açılan sayfalar: hangi gruba bağlı olduklarını söyler (doğru sekme vurgulansın). */\nexport const ALT_SAYFA: Record<string, string> = { menu: 'subeler', personel: 'subeler', vardiya: 'subeler', gelisim: 'subeler', genel: 'ana' };\nexport const grupOf = (tab: string): Grup => GRUPLAR.find((g) => g.tabs.includes(tab)) ?? GRUPLAR.find((g) => g.id === ALT_SAYFA[tab]) ?? GRUPLAR[0]!;\n/** Şube gerektiren sayfalar (şubesiz başlangıçta \"önce şube aç\" kartı gösterilir). */\nconst BRANCH_TABS = new Set(['stok', 'tedarik', 'reklam', 'kampanya', 'online', 'sosyal', 'menu', 'personel', 'vardiya', 'gelisim', 'musteri', 'ekonomi', 'iller', 'subeler', 'franchise', 'rapor', 'genel', 'merkez', 'usta', 'takvim', 'mudavim', 'esnaf', 'hikaye', 'tedil', 'yorumlar', 'grafik', 'donem', 'sezon', 'yatirim', 'kavurmahane', 'kurye', 'mulk', 'sadakat', 'basin', 'anket', 'mevzuat', 'surdur', 'sigorta']);\nexport const isBranchTab = (t: string): boolean => BRANCH_TABS.has(t);\n\nexport const S = (): GameState => ctx.S!;\nexport const cur = (): Branch => { const s = S(); const b = s.subeler.find((x) => x.id === ctx.bid) ?? s.subeler[0]!; if (b) ctx.bid = b.id; return b as Branch; };\nexport const esc = (s: string): string => s.replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' } as Record<string, string>)[c] ?? c);\nexport const bar = (v: number, col = 'var(--am)'): string => `<div class=\"bar\"><i style=\"width:${Math.max(0, Math.min(100, v))}%;background:${col}\"></i></div>`;\nexport const tr = (n: number, d = 1): string => n.toFixed(d).replace('.', ',');\nexport const sum = (o: object): number => Object.values(o as Record<string, number>).reduce((a, x) => a + x, 0);\nexport const cls = (v: number): string => (v >= 0 ? 'good' : 'badc');\nexport const stat = (l: string, v: number, inv = false): string => `<div class=\"small muted\">${l} <b style=\"color:var(--tx)\">${Math.round(v)}</b></div>${bar(v, (inv ? 100 - v : v) >= 60 ? 'var(--ok)' : (inv ? 100 - v : v) >= 35 ? 'var(--am)' : 'var(--bad)')}`;\nexport const note = (t: string): string => `<div class=\"card small muted\">${t}</div>`;\nexport const bchips = (): string => (S().subeler.length > 1 ? `<div class=\"chiprow\" style=\"margin-bottom:8px\">${S().subeler.map((x) => `<button class=\"cx ${x.id === cur().id ? 'on' : ''}\" data-a=\"bsel\" data-id=\"${x.id}\">${esc(cityById(x.city).ad)}${S().subeler.filter((y) => y.city === x.city).length > 1 ? ' ' + x.id : ''}</button>`).join('')}</div>` : '');\nconst sumRep = (a: Array<{ gelir: object; gider: object }>, key: 'gelir' | 'gider'): Record<string, number> => { const o: Record<string, number> = {}; for (const x of a) for (const k of Object.keys(x[key])) o[k] = (o[k] ?? 0) + (x[key] as Record<string, number>)[k]!; return o; };\nexport const rows = (o: Record<string, number>, names: Record<string, string>): string => Object.keys(names).filter((k) => (o[k] ?? 0) > 0.5).map((k) => `<div class=\"row small\"><span>${names[k]}</span><b>${fmt(o[k] ?? 0)}</b></div>`).join('') || '<div class=\"small muted\">—</div>';\nconst GELIR_AD = { kahve: 'Kahve satışları', yiyecek: 'Yiyecek satışları', ek: 'Ek satış (yanında alınan)', kampanya: 'Kampanyalı satış', paket: 'Paket servis', toplu: 'Toplu sipariş', etkinlik: 'Etkinlik', franchise: 'Franchise' };\nconst GIDER_AD = { malzeme: 'Satılan malın maliyeti', fire: 'Fire / bozulan ürün', maas: 'Personel maaşları', prim: 'Prim', egitim: 'Eğitim', isealim: 'İşe alım / tazminat', sadakat: 'Sadakat kartı programı', komisyon: 'Online platform komisyonu', kira: 'Kira', elektrik: 'Elektrik', su: 'Su', internet: 'İnternet', vergi: 'Vergiler', bakim: 'Bakım ve ekipman', sigorta: 'Sigorta', reklam: 'Reklam', stok: 'Stok bekletme' };\n\n/* ===================== 1 · Genel Bakış ===================== */\nfunction pGenel(): string {\n  const s = S(), b = cur(), t = s.rapor.slice(-7), kar7 = t.reduce((a, x) => a + x.kar, 0), dun = s.rapor[s.rapor.length - 1];\n  const az = INGREDIENTS.filter((i) => !b.siparisler.some((o) => o.ing === i.id) && (i.id !== 'clean' ? (b.stok[i.id] ?? 0) < Math.max(minLevel(b, i.id), 1) : (b.stok.clean ?? 0) < 2)), bos = gaps(b, dateOf(dayOf(s)).haftaGun, dayOf(s)).length, lv = levelOf(s), L = LEVELS[lv - 1]!, nx = LEVELS[lv];\n  const warn: string[] = []; if (az.length) warn.push(`📦 Stok azalıyor: ${az.map((i) => i.ad).join(', ')}`); if (bos) warn.push(`🗓️ Bugün ${bos} saat barista/kasiyer boşluğu var (Vardiyalar)`); if (b.sikayetler.length) warn.push(`👥 ${b.sikayetler.length} çalışan şikâyeti bekliyor (Personel)`); if (b.hijyen < 45) warn.push('🧽 Hijyen düşük; temizlik personeli ve temizlik malzemesi gerekli'); if (b.backlog > 400) warn.push('⏱️ Sipariş kuyruğu uzun; kapasite artır veya personel ekle'); if (s.kasa < 150000) warn.push('💰 Nakit az'); if (s.borc > 0) warn.push(`🏦 Borç: ${fmt(s.borc)}`);\n  const adv = priceAdvice(s, b); let sira: [string, string, string] = ['Fiyatlarını gözden geçir', 'Fiyat danışmanı kârı artıracak bir ayar önerebilir.', 'menu'];\n  if (az.length) sira = ['Stoğu tamamla', `${az.slice(0, 3).map((i) => i.ad).join(', ')} azalıyor; biterse satış durur.`, 'stok']; else if (bos) sira = ['Vardiya boşluğunu kapat', `Bugün ${bos} saat barista/kasiyer yok; o saatlerde müşteri kaybedersin.`, 'vardiya']; else if (b.hijyen < 50 && !b.staff.some((e) => e.tip === 'temizlik')) sira = ['Temizlik personeli al', `Hijyen ${Math.round(b.hijyen)}: düşük hijyen müşteriyi ve markayı eritir. Personel menüsünden Temizlik ilanı ver.`, 'personel']; else if (maasGeride(s, b)) sira = ['Maaşları güncelle', `${maasGeride(s, b)} çalışanın maaşı piyasanın altında; istifa riski var.`, 'personel']; else if (b.sikayetler.length) sira = ['Çalışan şikâyetine bak', 'Çözülmeyen şikâyetler motivasyonu ve performansı düşürür.', 'personel'];\n  else if (s.kasa > 1500000 && s.subeler.length < 3) sira = ['Büyü: yeni ilçe aç', 'Kasada birikmiş nakit var; yeni ilçe ve şube geliri artırır.', 'harita']; else if (adv.length) sira = ['Fiyat danışmanını dene', `${adv.length} üründe fiyat değişikliği tahmini kârı artırıyor.`, 'menu']; else if (s.gorevler.some((g) => !g.tamam)) sira = ['Görevlere bak', 'Tamamlanan her görev nakit ödül verir.', 'hedefler'];\n  return `<div class=\"card\" style=\"border-color:var(--am)\"><div class=\"tiny muted\">SIRADAKİ ADIM</div><b>${esc(sira[0])}</b><div class=\"small muted\">${esc(sira[1])}</div><button class=\"btn sm pri\" style=\"margin-top:6px\" data-a=\"git\" data-t=\"${sira[2]}\">Git →</button></div><div class=\"card\"><h3>${esc(b.ad)}</h3><div class=\"grid2\"><div><div class=\"tiny muted\">Bugün müşteri</div><b>${b.bugun.musteri}</b></div><div><div class=\"tiny muted\">Bugün gelir</div><b>${fmt(sum(b.bugun.gelir))}</b></div><div><div class=\"tiny muted\">Dünkü net kâr</div><b class=\"${cls(dun?.kar ?? 0)}\">${fmt(dun?.kar ?? 0)}</b></div><div><div class=\"tiny muted\">Son 7 gün net kâr</div><b class=\"${cls(kar7)}\">${fmt(kar7)}</b></div></div></div>\n  ${warn.length ? `<div class=\"card\" style=\"border-color:var(--bad)\"><h3>⚠️ Dikkat</h3>${warn.map((w) => `<div class=\"small\">${w}</div>`).join('')}</div>` : '<div class=\"card\"><div class=\"small good\">✓ Acil bir sorun görünmüyor.</div></div>'}\n  <div class=\"card\"><h3>Durum</h3>${stat('Müşteri memnuniyeti', b.memnuniyet)}${stat('Marka', b.marka)}${stat('Sadakat', b.sadakat)}${stat('Hijyen', b.hijyen)}<div class=\"row small\"><span>Yorum puanı</span><b>${tr(b.yorumPuan)} ★</b></div><div class=\"row small\"><span>Beklenen günlük talep</span><b>${Math.round(dailyDemand(s, b))} müşteri</b></div><div class=\"row small\"><span>Dış masa</span><b>${outdoorSeats(b)} kişi</b></div></div>\n  <div class=\"card\"><h3>🏢 ${esc(s.marka.ad)} · Seviye ${lv} (${L.ad})</h3>${nx ? `<div class=\"tiny muted\">Sonraki: ${nx.ad} — ${nx.sube} şube ve marka puanı ${nx.marka} gerekir (şimdi ${s.subeler.length} şube, ${Math.round(s.marka_puani)}).</div>` : '<div class=\"tiny muted\">En üst seviye.</div>'}${bar(s.marka_puani, 'var(--bl)')}</div>\n  <div class=\"card\"><h3>💬 Son yorumlar</h3>${b.yorumlar.slice(0, 4).map((r) => `<div class=\"small\"><b>${esc(r.kim)}</b> ${'★'.repeat(r.yildiz)}${'☆'.repeat(5 - r.yildiz)}<div class=\"muted\">${esc(r.metin)}</div></div>`).join('') || '<div class=\"small muted\">Henüz yorum yok.</div>'}</div><div class=\"card\"><h3>📰 Haberler</h3>${s.log.slice(0, 6).map((l) => `<div class=\"small muted\">• ${esc(l)}</div>`).join('') || '<div class=\"small muted\">—</div>'}</div>`;\n}\n\n/* ===================== 2 · Personel ===================== */\nfunction empCard(b: Branch, e: Employee, others: Branch[]): string {\n  const s = S(), tags = [e.mesai ? '⏱️ mesai' : '', e.hasta > 0 ? '🤒 devamsız' : '', e.egitim ? `🎓 eğitimde (${Math.max(0, e.egitim.bit - dayOf(s))} gün)` : '', e.sikayet > 0 ? `😠 ${e.sikayet} şikâyet` : ''].filter(Boolean).join(' · ');\n  return `<div class=\"card\"><div class=\"row\"><b>${STAFF_TYPE[e.tip].ikon} ${esc(e.ad)}</b><span class=\"pill\">${STAFF_TYPE[e.tip].ad}</span></div><div class=\"row small\"><span>Maaş · tecrübe</span><b>${fmt(e.maas)}/ay · ${e.tecrube} yıl</b></div><div class=\"row tiny muted\"><span>Piyasa maaşı ${fmt(marketWage(e.tip, e.tecrube, s.market.fiyat))} · ${SHIFT_NAME[e.vardiya]}${e.izin >= 0 ? ' · izin ' + DAYS[e.izin] : ''}</span><span>${e.prim ? 'prim ' + fmt(e.prim) : ''}</span></div>${tags ? `<div class=\"tiny\">${tags}</div>` : ''}\n  <div class=\"grid2\"><div>${stat('Beceri', e.beceri)}</div><div>${stat('Hız', e.hiz / 1.6 * 100)}</div><div>${stat('Müşteri ilişkisi', e.iliski)}</div><div>${stat('Disiplin', e.disiplin)}</div><div>${stat('Motivasyon', e.motivasyon)}</div><div>${stat('Memnuniyet', e.memnuniyet)}</div><div>${stat('Performans', e.performans)}</div><div>${stat('Yorgunluk', e.yorgunluk, true)}</div></div>${e.degerlendirme ? `<div class=\"tiny muted\">Son değerlendirme (${e.degerlendirme.puan}/100): ${esc(e.degerlendirme.not)}</div>` : ''}\n  <div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm\" data-a=\"wage\" data-id=\"${e.id}\" data-k=\"1.05\">Zam %5</button><button class=\"btn sm\" data-a=\"wage\" data-id=\"${e.id}\" data-k=\"0.95\">Kesinti %5</button><button class=\"btn sm\" data-a=\"bonus\" data-id=\"${e.id}\">Prim ${fmt(Math.round(e.maas * 0.15 / 500) * 500)}</button><button class=\"btn sm\" data-a=\"eval\" data-id=\"${e.id}\">Değerlendir</button><button class=\"btn sm\" data-a=\"promote\" data-id=\"${e.id}\">Terfi</button></div>\n  <details style=\"margin-top:6px\"><summary class=\"small muted\">Eğitim · nakil · işten çıkarma</summary><div class=\"chiprow\" style=\"margin:6px 0\">${TRAININGS.map((t) => `<button class=\"cx\" data-a=\"train\" data-id=\"${e.id}\" data-t=\"${t.id}\" title=\"${esc(t.ac)}\">🎓 ${t