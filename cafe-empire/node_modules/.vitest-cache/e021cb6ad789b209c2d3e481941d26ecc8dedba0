.kap} kg/gün · çekirdek maliyeti −%${Math.round(sv.ind * 100)} · kalite +%${(sv.kal * 100).toFixed(1)}` : 'Kendi çekirdeğini kavur: maliyet düşer, fazlasını toptan satarsın.'}</div></div></div>${nx ? `<div class=\"row small\" style=\"margin-top:8px\"><span>Sonraki: <b>${nx.ad}</b></span><b>${fmt(nx.kur * s.market.fiyat)}</b></div><div class=\"tiny muted\">Gereken: kafe seviyesi ${nx.sev}, ${nx.sube} şube. Günlük işletme ${fmt(nx.gun * s.market.fiyat)}.</div>${nd ? `<div class=\"tiny badc\">🔒 ${nd}</div>` : ''}<button class=\"btn sm pri\" data-a=\"kavYuk\" style=\"margin-top:6px\" ${nd ? 'disabled' : ''}>${k.seviye ? 'Yükselt' : 'Kavurmahane kur'}</button>` : '<div class=\"tiny good\" style=\"margin-top:6px\">En üst seviye.</div>'}</div></div>\n  <div class=\"duoR\"><div class=\"cardx\"><b>⚙️ İşletme</b>${k.seviye ? `<div class=\"row small\"><span>Kendi şubelerin ihtiyacı</span><b>${tr(kul, 0)} kg/gün</b></div><div class=\"row small\"><span>Kapasite</span><b>${sv.kap} kg/gün</b></div>${bar(sv.kap ? Math.min(100, kul / sv.kap * 100) : 0, kul > sv.kap ? 'var(--bad)' : 'var(--am)')}<div class=\"row small\"><span>Kendi ihtiyacını karşılama</span><b>%${Math.round(karsilama(s) * 100)}</b></div><div class=\"tiny muted\" style=\"margin-top:6px\">Toptan satış (artan kapasite)</div>${chip(TOPTAN.map((x, i): [string, string, boolean] => [String(i), x.ad, k.toptan === i]), 'kavTop')}<div class=\"row small\"><span>Bugünkü satış</span><b>${tr(k.gunKg, 0)} kg · ${fmt(k.gunGelir)}</b></div><div class=\"row small\"><span>Toplam toptan gelir</span><b class=\"good\">${fmt(k.gelir)}</b></div>` : '<div class=\"small muted\" style=\"margin-top:6px\">Kavurmahane kurulunca kapasite, toptan satış ve maliyet avantajı burada görünür.</div>'}</div></div></div>`;\n}\nexport function pKurye(): string {\n  const s = getS(), k = Kr(s), b = k.bugun, he = HAVA_ETKI[b.hava] ?? HAVA_ETKI.bulutlu!, kap = k.filo * KURYE_KAP * he.kap;\n  return `<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx zafer\"><div class=\"art\"><div class=\"artbox\">${kurye(100)}</div><div style=\"flex:1\"><div class=\"tiny muted\">KURYE FİLOSU</div><h3>${k.filo} kurye</h3><div class=\"small muted\">Her kurye günde ~${KURYE_KAP} sipariş, günlük ${fmt(KURYE_GUN * s.market.fiyat)}.</div></div></div><div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm\" data-a=\"kurFilo\" data-v=\"-1\">−1</button><button class=\"btn sm pri\" data-a=\"kurFilo\" data-v=\"1\">+1</button><button class=\"btn sm pri\" data-a=\"kurFilo\" data-v=\"5\">+5</button></div></div>\n  <div class=\"cardx\"><b>☁️ Bulut mutfaklar (${k.bulut}/${MAX_BULUT})</b><div class=\"tiny muted\">Yalnız paket servis mutfağı. Talep +%50 / mutfak, günlük ${fmt(BULUT_GUN * s.market.fiyat)}.</div><div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm pri\" data-a=\"bulutKur\">Bulut mutfak aç (${kisa(250000 * s.market.fiyat)} ₺)</button><button class=\"btn sm\" data-a=\"bulutKapat\">Kapat</button></div></div></div>\n  <div class=\"duoR\"><div class=\"cardx\"><b>📦 Bugün</b><div class=\"row small\"><span>Hava</span><b>${he.ad} (talep ×${he.talep}, kapasite ×${he.kap})</b></div><div class=\"row small\"><span>Sipariş talebi</span><b>${Math.round(b.talep)}</b></div><div class=\"row small\"><span>Kapasite</span><b>${Math.round(kap)}</b></div>${bar(b.talep ? Math.min(100, kap / b.talep * 100) : 0, kap >= b.talep ? 'var(--ok)' : 'var(--bad)')}<div class=\"row small\"><span>Teslim edilen</span><b class=\"good\">${Math.round(b.teslim)}</b></div><div class=\"row small\"><span>Karşılanamayan</span><b class=\"${b.kayip > 0 ? 'badc' : ''}\">${Math.round(b.kayip)}</b></div><div class=\"row small\"><span>Günlük gelir</span><b>${fmt(b.gelir)}</b></div><div class=\"row small\"><span>Toplam kurye geliri</span><b>${fmt(k.toplam)}</b></div><div class=\"tiny muted\" style=\"margin-top:6px\">Yağmur ve kar talebi artırır ama kapasiteyi düşürür; kötü havada daha çok kurye gerekir.</div></div></div></div>`;\n}\nexport function p