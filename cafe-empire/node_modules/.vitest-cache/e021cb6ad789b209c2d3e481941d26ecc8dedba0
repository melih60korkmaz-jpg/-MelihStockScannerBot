d)')}<div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm pri\" data-a=\"bulten\">📨 Basın bülteni (${fmt(8000 * s.market.fiyat)})</button><button class=\"btn sm\" data-a=\"krizAcik\">🧯 Kriz açıklaması</button></div></div>\n  <div class=\"cardx\"><b>📰 Haberler</b>${b.haberler.map((h) => `<div class=\"small\" style=\"padding:4px 0;border-top:1px solid var(--line)\"><span class=\"${h.pozitif ? 'good' : 'badc'}\">${h.pozitif ? '▲' : '▼'}</span> ${esc(h.baslik)} <span class=\"tiny muted\">(${now - h.gun} gün önce)</span></div>`).join('') || '<div class=\"small muted\" style=\"margin-top:6px\">Henüz haber yok.</div>'}</div></div>\n  <div class=\"duoR\"><div class=\"cardx\"><div class=\"row\"><b>🤳 Influencerlar</b><button class=\"btn sm\" data-a=\"infYenile\">Yenile</button></div><div class=\"tiny muted\">14 günlük anlaşma; %12 skandal riski. Aynı anda tek anlaşma.</div>${b.adaylar.map((x) => `<div class=\"row small\" style=\"margin-top:8px\"><span><b>${esc(x.ad)}</b><br><span class=\"tiny muted\">${kisa(x.takipci)} takipçi · kalite ${Math.round(x.kalite * 100)}</span></span><button class=\"btn sm pri\" data-a=\"infAnlas\" data-id=\"${x.id}\">${fmt(x.ucret * s.market.fiyat)}</button></div>`).join('') || '<div class=\"small muted\" style=\"margin-top:6px\">Aday yok; bir hafta sonra yeni aday çıkar.</div>'}</div></div></div>`;\n}\nexport function pAnket(): string {\n  const s = getS(), a = A(s), now = dayOf(s), b = cur(), r = a.sonuc[b.id], ab = a.ab;\n  if (!abA || !s.subeler.some((x) => x.id === abA)) abA = s.subeler[0]!.id; if (!abB || !s.subeler.some((x) => x.id === abB) || abB === abA) abB = (s.subeler.find((x) => x.id !== abA) ?? s.subeler[0]!).id;\n  const ad = (id: number): string => esc(s.subeler.find((x) => x.id === id)?.ad ?? '?');\n  return `${bchips()}<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx\"><b>📋 Müşteri anketi · ${esc(b.ad)}</b><div class=\"tiny muted\">Gerçek memnuniyet kırılımı, istenen ürünler ve öneriler. ${fmt(3000 * s.market.fiyat)}, 30 günde bir.</div><button class=\"btn sm pri\" data-a=\"anketYap\" style=\"margin:6px 0\" ${(a.son[b.id] ?? -99) > now - 30 ? 'disabled' : ''}>Anket yap</button>${r ? `<div class=\"tiny muted\">${now - r.gun} gün önceki sonuç</div>${[['Servis', r.hizmet], ['Ürün kalitesi', r.kalite], ['Fiyat memnuniyeti', r.fiyat]].map(([n, v]) => `<div class=\"row small\"><span>${n}</span><b>${Math.round(v as number)}</b></div>${bar(v as number, (v as number) >= 60 ? 'var(--ok)' : 'var(--am)')}`).join('')}<div class=\"row small\"><span>Tekrar gelme</span><b>%${Math.round(r.tekrar)}</b></div><div class=\"tiny muted\" style=\"margin-top:6px\">Müşterilerin menüde görmek istedikleri:</div><div class=\"chiprow\">${r.istek.map((id) => `<span class=\"pill\">${PRODUCT[id].ikon} ${PRODUCT[id].ad}</span>`).join('') || '—'}</div>${r.oneri.map((x) => `<div class=\"small\" style=\"padding:3px 0\">💡 ${esc(x)}</div>`).join('')}` : ''}</div></div>\n  <div class=\"duoR\"><div class=\"cardx\"><b>🧪 A/B test</b>${ab ? (ab.sonuc?.bitti ? `<div class=\"small\"><b>${DEGISKENLER.find((x) => x.id === ab.degisken)!.ad}</b> — ${ad(ab.b)} (deneme) vs ${ad(ab.a)} (kontrol)</div>${[['Ciro farkı', ab.sonuc.ciro], ['Kâr farkı', ab.sonuc.kar], ['Müşteri farkı', ab.sonuc.musteri]].map(([n, v]) => `<div class=\"row small\"><span>${n}</span><b class=\"${(v as number) >= 0 ? 'good' : 'badc'}\">${(v as number) >= 0 ? '+' : ''}${Math.round((v as number) * 100)}%</b></div>`).join('')}<div class=\"tiny muted\">${ab.sonuc.kar > 0.03 ? 'Deney kârı artırdı: tüm şubelere uygulayabilirsin.' : ab.sonuc.kar < -0.03 ? 'Deney kârı düşürdü: geri alman önerilir.' : 'Belirgin fark yok.'}</div><div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm pri\" data-a=\"abUygula\">Tümüne uygula</button><button class=\"btn sm\" data-a=\"abGeri\">Geri al</button></div>` : `<div class=\"small\">${DEGISKENLER.find((x) => x.id === ab.degisken)!.ad}: ${ad(ab.b)} deneniyor (kontrol: ${ad(ab.a)}).</div>${bar((now - ab.bas) / AB_GUN * 100, 'var(--am)')}<div class=\"tiny muted\">${Math.max(0, ab.bit - now)} gün kaldı.</div>`) : `<div class=\"tiny muted\">İki şubeyi seç: biri kontrol, diğeri deneme. ${AB_GUN} gün sonra karşılaştırılır. En az 2 şube ve 14 günlük geçmiş gerekir.</div><div class=\"tiny muted\">Kontrol şube</div>${chip(s.subeler.map((x): [string, string, boolean] => [String(x.id), esc(x.ad.split(' ').pop() ?? x.ad), abA === x.id]), 'abA')}<div class=\"tiny muted\">Deneme şube</div>${chip(s.subeler.map((x): [string, string, boolean] => [String(x.id), esc(x.ad.split(' ').pop() ?? x.ad), abB === x.id]), 'abB')}<div class=\"tiny muted\">Değişiklik</div>${chip(DEGISKENLER.map((x): [string, string, boolean] => [x.id, x.ad, abV === x.id]), 'abV')}<button class=\"btn sm pri\" data-a=\"abBasla\">Testi başlat</button>`}</div></div></div>`;\n}\nexport function pMevzuat(): string {\n  const s = getS(), m = Mv(s);\n  return `<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx zafer\"><div class=\"row\"><b>⚖️ Vergi uyum puanı</b><span class=\"pill ${m.uyum >= 70 ? 'good2' : ''}\">${Math.round(m.uyum)}/100</span></div>${bar(m.uyum, m.uyum >= 70 ? 'var(--ok)' : m.uyum >= 40 ? 'var(--am)' : 'var(--bad)')}<div class=\"tiny muted\">Vergi denetimi çıktığında sonucu belirler (≥70 temiz, 40–70 ceza, altı ağır ceza).</div><button class=\"btn sm ${m.muhasebe ? 'on' : 'pri'}\" data-a=\"muhasebeci\" style=\"margin-top:6px\">${m.muhasebe ? '✓ Muhasebeci tutuldu' : 'Muhasebeci tut'} (${fmt(MUHASEBE_AYLIK * s.market.fiyat)}/ay)</button><div class=\"row small\"><span>Toplam ceza</span><b class=\"badc\">${fmt(m.ceza)}</b></div><div class=\"row small\"><span>Alınan teşvikler</span><b class=\"good\">${fmt(m.destek)}</b></div></div></div>\n  <div class=\"duoR\"><div class=\"cardx\"><b>📜 Ruhsatlar</b><div class=\"tiny muted\">Süre bitmeden son 60 günde yenile (${fmt(RUHSAT_UCRET * s.market.fiyat)}). Süresi geçen ruhsat ceza ve mühürleme riski getirir.</div>${s.subeler.map((b) => { const kal = ruhsatKalan(s, b); return `<div class=\"row small\" style=\"margin-top:6px\"><span>${esc(b.ad)}</span><b class=\"${kal < 0 ? 'badc' : kal < 60 ? '' : 'good'}\">${kal < 0 ? `${-kal} gün gecikmiş` : `${kal} gün`}</b></div><div class=\"chiprow\"><button class=\"btn sm\" data-a=\"ruhsat\" data-id=\"${b.id}\" ${kal > 60 ? 'disabled' : ''}>Yenile</button></div>`; }).join('')}</div>\n  <div class=\"cardx\"><b>🏛️ İstihdam teşviki</b><div class=\"tiny muted\">İlk 180 günde, en az 3 çalışanlı şubeler başvurabilir. Başvuru ${fmt(1500 * s.market.fiyat)}; %70 onay, ~${fmt(35000 * s.market.fiyat)} destek.</div>${s.subeler.map((b) => { const t = m.tesvik[b.id], nd = tesvikUygun(s, b); return `<div class=\"row small\" style=\"margin-top:6px\"><span>${esc(b.ad)}</span>${t ? `<b class=\"${t.durum === 'onay' ? 'good' : t.durum === 'red' ? 'badc' : ''}\">${t.durum === 'bekle' ? 'inceleniyor' : t.durum === 'onay' ? 'onaylandı' : 'reddedildi'}</b>` : `<button class=\"btn sm\" data-a=\"tesvik\" data-id=\"${b.id}\" ${nd ? 'disabled' : ''}>Başvur</button>`}</div>${!t && nd ? `<div class=\"tiny muted\">${nd}</div>` : ''}`; }).join('')}</div></div></div>`;\n}\nexport function pSurdur(): string {\n  const s = getS(), k = Sr(s), sk = skor(s);\n  return `<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx zafer\"><div class=\"art\"><div class=\"artbox\">${yaprak(sk, 88)}</div><div style=\"flex:1\"><div class=\"tiny muted\">YEŞİL SKOR</div><h3>${sk}/100${k.sertifika ? ' 🏅' : ''}</h3><div class=\"small muted\">Talebe etki +%${tr(0.06 * sk + (k.sertifika ? 4 : 0), 1)} · skor ≥ 50 ise itibar günlük artar.</div></div></div><div class=\"row small\"><span>Toplam tasarruf</span><b class=\"good\">${fmt(k.tasarruf)}</b></div></div></div>\n  <div class=\"duoR\">${PROGRAMLAR.map((p) => `<div class=\"rowb ${k.prog[p.id] ? 'fir' : ''}\"><i>${hareketli(p.ik)}</i><span><b>${p.ad} <span class=\"tiny muted\">+${p.skor}</span></b><small>${p.ac} ${p.kur ? `Kurulum: ${fmt(p.kur * s.market.fiyat * (p.id === 'sifir' ? 1 : s.subeler.length))}.` : ''}${p.gun ? ` Günlük ${fmt(p.gun * s.market.fiyat * (p.id === 'sifir' ? 1 : s.subeler.length))}.` : ''}</small></span><button class=\"btn sm ${k.prog[p.id] ? '' : 'pri'}\" data-a=\"surd\" data-id=\"${p.id}\">${k.prog[p.id] ? 'Bırak' : 'Başlat'}</button></div>`).join('')}</div></div>`;\n}\nexport function pSigorta(): string {\n  const s = getS(), a = Af(s), tur = Object.keys(TURLER);\n  return `<div class=\"cardx small muted\">${hareketli('🛡️')} Afetler bölgeye göre farklı risk taşır. Sigorta hasarın %60–90'ını karşılar; jeneratör elektrik kesintisinde kaybı sıfırlar. Toplam prim ${fmt(a.odenenPrim)}, sigortanın ödediği ${fmt(a.karsilanan)}.</div><div class=\"cards2\">${s.subeler.map((b) => { const c = cityById(b.city), pl = a.plan[b.id] ?? 0; return `<div class=\"cardx\"><div class=\"art\"><div class=\"artbox\" style=\"width:76px\">${kalkan(pl, 52)}</div><div style=\"flex:1\"><b>${esc(b.ad)}</b><div class=\"tiny muted\">${esc(c.ad)} · ${REGION_NAME[c.region]} · varlık ~${kisa(varlik(s, b))} ₺</div></div></div><div class=\"tiny muted\">Risk: ${tur.map((t) => `${TURLER[t]!.ik}${Math.round(risk(b.city, t) * 100)}`).join(' ')}</div>${chip(PLANLAR.map((p, i): [string, string, boolean] => [`${b.id}:${i}`, `${p.ad}${p.prim ? ` (%${(p.prim * 100).toFixed(1)}/yıl)` : ''}`, pl === i]), 'sigPlan')}<button class=\"btn sm ${a.jenerator[b.id] ? 'on' : ''}\" data-a=\"jenerator\" data-id=\"${b.id}\" ${a.jenerator[b.id] ? 'disabled' : ''}>${a.jenerator[b.id] ? '✓ Jeneratör var' : `🔌 Jeneratör (${kisa(JENERATOR * s.market.fiyat)} ₺)`}</button></div>`; }).join('')}</div>${a.gecmis.length ? `<div class=\"cardx\"><b>Afet geçmişi</b>${a.gecmis.map((g) => `<div class=\"row small\"><span>${g.tur} · ${esc(g.sube)}</span><b>${kisa(g.hasar)} ₺ (sigorta ${kisa(g.karsilanan)} ₺)</b></div>`).join('')}</div>` : ''}`;\n}\nexport const ISLER_PAGES: Record<string, () => string> = { kavurmahane: pKavurma, kurye: pKurye, mulk: pMulk, sadakat: pSadakat, basin: pBasin, anket: pAnket, mevzuat: pMevzuat, surdur: pSurdur, sigorta: pSigorta };\nexport function handleIsler(a: string, d: DOMStringMap, h: Helpers): boolean {\n  const s = getS(), R = (r: { ok: boolean; m: string }): boolean => { h.res(r); h.refresh(); return true; }, n = (v?: string): number => +(v ?? 0);\n  switch (a) {\n    case 'kavYuk': return R(kavYukselt(s)); case 'kavTop': return R(kavToptan(s, n(d.v))); case 'kurFilo': return R(kuryeAyarla(s, n(d.v))); case 'bulutKur': return R(bulutKur(s)); case 'bulutKapat': return R(bulutKapat(s));\n    case 'mulkAl': return R(mulkAl(s, n(d.id))); case 'mulkSat': return R(mulkSat(s, n(d.id))); case 'sadKur': return R(sadKur(s)); case 'sadPuan': return R(sadPuan(s, n(d.v))); case 'sadKamp': return R(sadKampanya(s, d.id!));\n    case 'bulten': return R(bulten(s)); case 'krizAcik': return R(krizAciklamasi(s)); case 'infYenile': adaylariYenile(s); h.refresh(); return true; case 'infAnlas': return R(influencerAnlas(s, d.id!));\n    case 'anketYap': return R(anketYap(s, cur())); case 'abA': abA = n(d.v); h.refresh(); return true; case 'abB': abB = n(d.v); h.refresh(); return true; case 'abV': abV = d.v!; h.refresh(); return true;\n    case 'abBasla': return R(abBaslat(s, abA, abB, abV as never)); case 'abUygula': return R(abSonuc(s, true)); case 'abGeri': return R(abSonuc(s, false));\n    case 'muhasebeci': return R(muhasebeci(s)); case 'ruhsat': return R(ruhsatYenile(s, n(d.id))); case 'tesvik': return R(tesvikBasvur(s, n(d.id))); case 'surd': return R(programKur(s, d.id!));\n    case 'sigPlan': { const [b, p] = d.v!.split(':'); return R(planDegistir(s, n(b), n(p))); } case 'jenerator': return R(jeneratorAl(s, n(d.id)));\n    default: return false;\n  }\n}\nvoid D;\n"],"file":"/src/ui/isler.ts"}