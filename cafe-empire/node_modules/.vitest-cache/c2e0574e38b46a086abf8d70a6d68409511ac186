mport { fmt } from '../core/actions';\nimport { profitCurve, priceAdvice } from '../core/pricing';\nimport { sellPrice, levelOf } from '../core/sim';\nimport type { Branch, DayReport, GameState } from '../core/types';\n\nexport interface EcoOpts { per: number; scope: 'all' | 'sube'; curve: ProductId; anim: boolean }\nconst PAL = ['#e0983c', '#4aa3e8', '#5fc08a', '#e8665f', '#a98be0', '#f0d264', '#6fd3d3', '#c98a6f'];\nconst GELIR: Record<string, string> = { kahve: 'Kahve', yiyecek: 'Yiyecek', ek: 'Ek satış', kampanya: 'Kampanyalı', paket: 'Paket servis', toplu: 'Toplu sipariş', etkinlik: 'Etkinlik', franchise: 'Franchise' };\nconst GIDER: Record<string, string> = { malzeme: 'Malzeme (COGS)', maas: 'Personel', kira: 'Kira', elektrik: 'Elektrik', su: 'Su', internet: 'İnternet', vergi: 'Vergi', bakim: 'Bakım/ekipman', sigorta: 'Sigorta', reklam: 'Reklam', fire: 'Fire', stok: 'Stok bekletme', prim: 'Prim', egitim: 'Eğitim', isealim: 'İşe alım', sadakat: 'Sadakat kartı', komisyon: 'Platform komisyonu' };\nconst sumK = (a: DayReport[], key: 'gelir' | 'gider'): Record<string, number> => { const o: Record<string, number> = {}; for (const r of a) for (const k of Object.keys(r[key])) o[k] = (o[k] ?? 0) + (r[key] as unknown as Record<string, number>)[k]!; return o; };\nconst tr = (n: number, d = 0): string => n.toFixed(d).replace('.', ',');\nconst cnt = (v: number, anim: boolean, cls = ''): string => `<b class=\"cnt ${cls}\" data-v=\"${Math.round(v)}\">${anim ? '0 ₺' : fmt(v)}</b>`;\nconst A = (anim: boolean, c: string): string => (anim ? ' ' + c : '');\n\nfunction donut(items: Array<{ l: string; v: number }>, anim: boolean, title: string): string {\n  const L = items.filter((x) => x.v > 0.5).sort((a, b) => b.v - a.v), tot = L.reduce((a, x) => a + x.v, 0); if (!tot) return `<div class=\"card\"><h3>${title}</h3><div class=\"small muted\">Veri yok.</div></div>`;\n  let acc = 0; const segs = L.map((x, i) => { const p = x.v / tot * 100, s = `<circle class=\"dseg${A(anim, 'dgo')}\" cx=\"21\" cy=\"21\" r=\"15.915\" fill=\"none\" stroke=\"${PAL[i % PAL.length]}\" stroke-width=\"7\" pathLength=\"100\" stroke-dasharray=\"${Math.max(0.2, p - 0.4).toFixed(2)} ${(100 - Math.max(0.2, p - 0.4)).toFixed(2)}\" stroke-dashoffset=\"${(-acc).toFixed(2)}\" style=\"animation-delay:${i * 90}ms\"><title>${x.l}</title></circle>`; acc += p; return s; }).join('');\n  return `<div class=\"card\"><h3>${title}</h3><div class=\"donutrow\"><svg viewBox=\"0 0 42 42\" class=\"donut\"><g transform=\"rotate(-90 21 21)\">${segs}</g><text x=\"21\" y=\"20\" class=\"dt1\">${fmt(tot)}</text><text x=\"21\" y=\"25\" class=\"dt2\">toplam</text></svg><div class=\"legend2\">${L.slice(0, 8).map((x, i) => `<div class=\"lg\"><i style=\"background:${PAL[i % PAL.length]}\"></i><span>${x.l}</span><b>%${Math.round(x.v / tot * 100)}</b><small>${fmt(x.v)}</small></div>`).join('')}</div></div></div>`;\n}\nfunction bars(rep: DayReport[], anim: boolean): string {\n  if (!rep.length) return '<div class=\"small muted\">Henüz kapanmış gün yok.</div>'; const n = rep.length, W = 300, H = 110, bw = W / n, mx = Math.max(1, ...rep.map((r) => Math.max(r.toplamGelir, r.toplamGider))), base = 92;\n  const y = (v: number): number => (v / mx) * 78; const net = rep.map((r, i) => `${(i * bw + bw / 2).toFixed(1)},${(base - y(Math.max(-mx, r.kar)) ).toFixed(1)}`).join(' ');\n  return `<svg viewBox=\"0 0 ${W} ${H}\" class=\"bchart\"><line x1=\"0\" x2=\"${W}\" y1=\"${base}\" y2=\"${base}\" stroke=\"rgba(255,255,255,.2)\"/>${rep.map((r, i) => `<rect class=\"bgr${A(anim, 'bgo')}\" style=\"animation-delay:${Math.min(900, i * 18)}ms\" x=\"${(i * bw + bw * 0.1).toFixed(1)}\" y=\"${(base - y(r.toplamGelir)).toFixed(1)}\" width=\"${(bw * 0.38).toFixed(1)}\" height=\"${Math.max(0.5, y(r.toplamGelir)).toFixed(1)}\" fill=\"#5fc08a\"><title>Gün ${r.gun} · gelir ${fmt(r.toplamGelir)}</title></rect><rect class=\"bgr${A(anim, 'bgo')}\" style=\"animation-delay:${Math.min(900, i * 18) + 60}ms\" x=\"${(i * bw + bw * 0.5).toFixed(1)}\" y=\"${(base - y(r.toplamGider)).toFixed(1)}\" width=\"${(bw * 0.38).toFixed(1)}\" height=\"${Math.max(0.5, y(r.toplamGider)).toFixed(1)}\" fill=\"#e8665f\" opacity=\".85\"><title>Gün ${r.gun} · gider ${fmt(r.toplamGider)}</title></rect>`).join('')}<polyline class=\"nline${A(anim, 'ngo')}\" points=\"${net}\" fill=\"none\" stroke=\"#4aa3e8\" stroke-width=\"1.6\" pathLength=\"100\" stroke-dasharray=\"100\" /></svg><div class=\"tiny muted\"><span style=\"color:#5fc08a\">■</span> gelir <span style=\"color:#e8665f\">■</span> gider <span style=\"color:#4aa3e8\">━</span> net kâr · ölçek ${fmt(mx)}</div>`;\n}\nfunction flow(g: number, g1: Record<string, number>, anim: boolean): string {\n  const cogs = g1.malzeme ?? 0, maas = (g1.maas ?? 0) + (g1.prim ?? 0), kira = g1.kira ?? 0, tot = Object.values(g1).reduce((a, x) => a + x, 0), diger = Math.max(0, tot - cogs - maas - kira), net = g - tot, den = Math.max(g, tot, 1);\n  const seg = (v: number, c: string, l: string, i: number) => `<div class=\"fseg${A(anim, 'fgo')}\" style=\"width:${(Math.max(0, v) / den * 100).toFixed(2)}%;background:${c};animation-delay:${i * 140}ms\" title=\"${l}: ${fmt(v)}\"></div>`;\n  return `<div class=\"card\"><h3>Para nereye gidiyor?</h3><div class=\"fbar\">${seg(cogs, '#e0983c', 'Malzeme', 0)}${seg(maas, '#4aa3e8', 'Personel', 1)}${seg(kira, '#a98be0', 'Kira', 2)}${seg(diger, '#8a8f98', 'Diğer', 3)}${net > 0 ? seg(net, '#5fc08a', 'Net kâr', 4) : ''}</div><div class=\"fbar2\"><div style=\"width:${Math.min(100, g / den * 100).toFixed(1)}%\" class=\"fline${A(anim, 'fgo')}\"></div></div><div class=\"chiprow tiny\"><span style=\"color:#e0983c\">■ Malzeme ${g ? Math.round(cogs / g * 100) : 0}%</span><span style=\"color:#4aa3e8\">■ Personel ${g ? Math.round(maas / g * 100) : 0}%</span><span style=\"color:#a98be0\">■ Kira ${g ? Math.round(kira / g * 100) : 0}%</span><span style=\"color:#8a8f98\">■ Diğer ${g ? Math.round(diger / g * 100) : 0}%</span><span style=\"color:${net >= 0 ? '#5fc08a' : '#e8665f'}\">■ ${net >= 0 ? 'Net kâr' : 'Zarar'} ${g ? Math.round(net / g * 100) : 0}%</span></div><div class=\"tiny muted\">Üstteki çubuk giderleri ve kârı, alttaki çizgi geliri gösterir; çubuk çizgiden uzunsa zarar edersin.</div></div>`;\n}\nfunction curve(s: GameState, b: Branch, id: ProductId, anim: boolean): string {\n  const act = PRODUCTS.filter((p) => b.menu[p.id].aktif && levelOf(s) >= p.seviye), chips = act.slice(0, 14).map((p) => `<button class=\"cx ${p.id === id ? 'on' : ''}\" data-a=\"ecurve\" data-id=\"${p.id}\">${p.ikon} ${p.ad}</button>`).join('');\n  const pts = profitCurve(s, b, id); if (pts.length < 3) return `<div class=\"card\"><h3>Fiyat – kâr eğrisi</h3><div class=\"chiprow\">${chips}</div><div class=\"small muted\" style=\"margin-top:6px\">Eğri için menüde aktif bir ürün seç.</div></div>`;\n  const mn = Math.min(...pts.map((p) => p.kar)), mx = Math.max(...pts.map((p) => p.kar)), rg = Math.max(1, mx - mn), W = 300, H = 100, x = (i: number): number => 8 + i * (W - 16) / (pts.length - 1), y = (v: number): number => 86 - (v - mn) / rg * 70;\n  const cur = b.menu[id].fiyat, ci = pts.findIndex((p) => Math.abs(p.m - cur) < 0.026), best = pts.reduce((bi, p, i) => (p.kar > pts[bi]!.kar ? i : bi), 0), d = pts.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(p.kar).toFixed(1)}`).join('');\n  const now = sellPrice(s, b, id), adv = priceAdvice(s, b).find((o) => o.id === id);\n  return `<div class=\"card\"><h3>Fiyat – kâr eğrisi</h3><div class=\"chiprow\" style=\"margin-bottom:6px\">${chips}</div><svg viewBox=\"0 0 ${W} ${H}\" class=\"cchart\"><defs><linearGradient id=\"cg\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#e0983c\" stop-opacity=\".45\"/><stop offset=\"1\" stop-color=\"#e0983c\" stop-opacity=\"0\"/></linearGradient></defs><path d=\"${d}L${x(pts.length - 1)} 90L${x(0)} 90Z\" fill=\"url(#cg)\"/><path class=\"cpath${A(anim, 'cgo')}\" d=\"${d}\" fill=\"none\" stroke=\"#f4b660\" stroke-width=\"2\" pathLength=\"100\" stroke-dasharray=\"100\"/>${pts.map((p, i) => `<circle class=\"cpt\" cx=\"${x(i).toFixed(1)}\" cy=\"${y(p.kar).toFixed(1)}\" r=\"5\" fill=\"transparent\" data-a=\"fiyatset\" data-id=\"${id}\" data-m=\"${p.m}\"><title>${p.fiyat} ₺ → ≈${fmt(p.kar)}/gün</title></circle>`).join('')}${ci >= 0 ? `<circle cx=\"${x(ci).toFixed(1)}\" cy=\"${y(pts[ci]!.kar).toFixed(1)}\" r=\"3.6\" fill=\"#fff\"/><text x=\"${x(ci).toFixed(1)}\" y=\"${(y(pts[ci]!.kar) - 6).toFixed(1)}\" class=\"cl\">şimdi</text>` : ''}<circle class=\"best${A(anim, 'bgo2')}\" cx=\"${x(best).toFixed(1)}\" cy=\"${y(pts[best]!.kar).toFixed(1)}\" r=\"4\" fill=\"#5fc08a\"/><text x=\"${x(best).toFixed(1)}\" y=\"${(y(pts[best]!.kar) - 7).toFixed(1)}\" class=\"cl\" fill=\"#5fc08a\">en iyi</text><text x=\"8\" y=\"98\" class=\"cl\">${pts[0]!.fiyat} ₺</text><text x=\"${W - 8}\" y=\"98\" class=\"cl\" text-anchor=\"end\">${pts[pts.length - 1]!.fiyat} ₺</text></svg><div class=\"small\">Şimdi <b>${now} ₺</b> → günlük ≈ <b>${fmt(ci >= 0 ? pts[ci]!.kar : 0)}</b> brüt kâr · modele göre en iyi <b class=\"good\">${pts[best]!.fiyat} ₺</b> (≈ ${fmt(pts[best]!.kar)})${adv ? '' : ' — zaten dengeli'}.</div><div class=\"tiny muted\">Eğriye dokunarak o fiyatı uygula. Eğri müşteri tepki modelinin beklenen değeridir; kesin sonuç değildir ve çok yüksek fiyat uzun vadede memnuniyeti düşürür.</div></div>`;\n}\nconst SW = (on: boolean | undefined): string => (on ? 'on' : '');\nexport function pEkonomi(s: GameState, b: Branch, o: EcoOpts): string {\n  const src = o.scope === 'all' ? s.rapor : b.gecmis, rep = src.slice(-o.per), prev = src.slice(-2 * o.per, -o.per), n = Math.max(1, rep.length), anim = o.anim;\n  const g = rep.reduce((a, r) => a + r.toplamGelir, 0), gi = rep.reduce((a, r) => a + r.toplamGider, 0), net = g - gi, nakit = rep.reduce((a, r) => a + r.nakit + r.capex, 0), ms = rep.reduce((a, r) => a + r.musteri, 0), cg = rep.reduce((a, r) => a + r.cogs, 0), gprev = prev.reduce((a, r) => a + r.toplamGelir, 0), netPrev = prev.reduce((a, r) => a + r.kar, 0);\n  const g1 = sumK(rep, 'gider'), ge = sumK(rep, 'gelir'), fixed = ((g1.kira ?? 0) + (g1.maas ?? 0) + (g1.elektrik ?? 0) + (g1.su ?? 0) + (g1.internet ?? 0) + (g1.bakim ?? 0) + (g1.sigorta ?? 0)) / n, perCust = ms ? (g - cg) / ms : 0, be = perCust > 0 ? Math.ceil(fixed / perCust) : 0, burn = -(nakit / n);\n  const arrow = (a: number, p: number): string => (!prev.length ? '' : a >= p ? `<span class=\"good\">▲ %${p ? Math.round((a - p) / Math.abs(p) * 100) : 0}</span>` : `<span class=\"badc\">▼ %${p ? Math.round((p - a) / Math.abs(p) * 100) : 0}</span>`);\n  const scopeBtn = `<div class=\"chiprow\" style=\"margin-bottom:8px\"><button class=\"cx ${o.scope === 'all' ? 'on' : ''}\" data-a=\"escope\" data-k=\"all\">Tüm şirket</button><button class=\"cx ${o.scope === 'sube' ? 'on' : ''}\" data-a=\"escope\" data-k=\"sube\">${b.ad.length > 22 ? b.ad.slice(0, 21) + '…' : b.ad}</button>${[7, 30, 90].map((d) => `<button class=\"cx ${o.per === d ? 'on' : ''}\" data-a=\"eper\" data-n=\"${d}\">${d} gün</button>`).join('')}</div>`;\n  const kpi = `<div class=\"kpis\"><div class=\"kpi\"><div class=\"tiny muted\">Kasa</div>${cnt(s.kasa, anim)}<div class=\"tiny muted\">${s.borc > 0 ? 'Borç ' + fmt(s.borc) : 'Borç yok'}</div></div><div class=\"kpi\"><div class=\"tiny muted\">Gelir / gün</div>${cnt(g / n, anim)}<div class=\"tiny\">${arrow(g, gprev)}</div></div><div class=\"kpi\"><div class=\"tiny muted\">Net kâr / gün</div>${cnt(net / n, anim, net >= 0 ? 'good' : 'badc')}<div class=\"tiny\">${arrow(net, netPrev)}</div></div><div class=\"kpi\"><div class=\"tiny muted\">İşletme nakit akışı / gün</div>${cnt(nakit / n, anim, nakit >= 0 ? 'good' : 'badc')}<div class=\"tiny muted\">${burn > 0 ? 'Nakit yeter (yatırım hariç): ' + (s.kasa > 0 ? Math.floor(s.kasa / burn) + ' gün' : '—') : 'Nakit artıyor'}</div></div></div>`;\n  const rank = [...s.subeler].map((x) => ({ x, k: x.gecmis.slice(-o.per).reduce((a, r) => a + r.kar, 0), g: x.gecmis.slice(-o.per).reduce((a, r) => a + r.toplamGelir, 0) })).sort((a, z) => z.k - a.k), rmx = Math.max(1, ...rank.map((r) => Math.abs(r.k)));\n  const unit = `<div class=\"card\"><h3>Birim ekonomisi</h3><div class=\"grid2 small\"><div><div class=\"tiny muted\">Ortalama sepet</div><b>${ms ? fmt(g / ms) : '—'}</b></div><div><div class=\"tiny muted\">Müşteri başı brüt kâr</div><b>${ms ? fmt(perCust) : '—'}</b></div><div><div class=\"tiny muted\">Malzeme / gelir</div><b>${g ? '%' + Math.round(cg / g * 100) : '—'}</b></div><div><div class=\"tiny muted\">Personel / gelir</div><b>${g ? '%' + Math.round(((g1.maas ?? 0) + (g1.prim ?? 0)) / g * 100) : '—'}</b></div><div><div class=\"tiny muted\">Sabit gider / gün</div><b>${fmt(fixed)}</b></div><div><div class=\"tiny muted\">Başabaş müşteri / gün</div><b>${be ? be : '—'}</b></div></div><div class=\"tiny muted\" style=\"margin-top:4px\">Günlük ortalama ${tr(ms / n, 0)} müşteri geldi; başabaş için ≈ ${be || '—'} müşteri gerekir.</div></div>`;\n  const rk = `<div class=\"card\"><h3>Şube sıralaması (${o.per} gün net kâr)</h3>${rank.map((r, i) => `<div class=\"rrow\"><span class=\"rn\">${i + 1}. ${r.x.ad.length > 20 ? r.x.ad.slice(0, 19) + '…' : r.x.ad}</span><div class=\"rbar\"><i class=\"${anim ? 'rgo' : ''}\" style=\"width:${Math.max(2, Math.abs(r.k) / rmx * 100).toFixed(0)}%;background:${r.k >= 0 ? '#5fc08a' : '#e8665f'};animation-delay:${i * 100}ms\"></i></div><b class=\"${r.k >= 0 ? 'good' : 'badc'}\">${fmt(r.k)}</b></div>`).join('')}</div>`;\n  const ctrl = kontrolHtml(s, b);\n  return `${scopeBtn}${kpi}${flow(g, g1, anim)}<div class=\"card\"><h3>Gelir ve gider (${rep.length} gün)</h3>${bars(rep, anim)}</div>${donut(Object.keys(ge).map((k) => ({ l: GELIR[k] ?? k, v: ge[k]! })), anim, 'Gelir kaynakları')}${donut(Object.keys(g1).map((k) => ({ l: GIDER[k] ?? k, v: g1[k]! })), anim, 'Gider kalemleri')}${unit}${rk}${curve(s, b, o.curve, anim)}${ctrl}`;\n}\n\n/** Kampanya ve toplu yönetim kontrolleri (Pazarlama → Kampanyalar). */\nexport function kontrolHtml(s: GameState, b: Branch): string {\n  const aktif = PRODUCTS.filter((p) => b.menu[p.id].aktif).slice(0, 10), pr = b.promo ?? {}, gun = pr.gununGun === Math.floor(s.dk / 1440) ? pr.gunun : null;\n  return `<div class=\"card\"><h3>🎛️ Yönetim kontrolleri — ${b.ad.length > 22 ? b.ad.slice(0, 21) + '…' : b.ad}</h3>\n  <div class=\"tiny muted\">Kampanyalar (bu şube). Kampanyalar gelir kalemlerinde \"Kampanyalı satış\" olarak görünür.</div><div class=\"chiprow\" style=\"margin:6px 0\"><button class=\"cx ${SW(pr.sabah)}\" data-a=\"promo\" data-k=\"sabah\">🌅 Sabah paketi (07–11)</button><button class=\"cx ${SW(pr.mutlu)}\" data-a=\"promo\" data-k=\"mutlu\">🍹 Mutlu saat (15–18)</button><button class=\"cx ${SW(pr.ogrenci)}\" data-a=\"promo\" data-k=\"ogrenci\">🎓 Öğrenci indirimi</button><button class=\"cx ${SW(pr.kart)}\" data-a=\"promo\" data-k=\"kart\">💳 Sadakat kartı</button><button class=\"cx ${SW(pr.yetkiFiyat)}\" data-a=\"promo\" data-k=\"yetkiFiyat\">🧑‍💼 Müdür fiyat yetkisi</button></div>\n  <div class=\"tiny muted\">Sabah paketi: içecek+yiyecek −%12, daha çok ikinci ürün. Mutlu saat: −%15, +%12 trafik. Öğrenci: −%10 ve daha çok öğrenci. Sadakat kartı: −%3, tekrar gelen müşteri artar, ciroya %0,6 maliyet. Müdür yetkisi: haftada bir fiyatları ±%8 içinde ayarlar.</div>\n  <div class=\"eyebrow\">Günün ürünü (bugün −%15 ve öne çıkar)</div><div class=\"chiprow\">${aktif.map((p) => `<button class=\"cx ${gun === p.id ? 'on' : ''}\" data-a=\"gunun\" data-id=\"${p.id}\">${p.ikon} ${p.ad}</button>`).join('')}</div>\n  <div class=\"eyebrow\">Toplu fiyat</div><div class=\"chiprow\"><button class=\"btn sm\" data-a=\"tumfiyat\" data-k=\"0.95\">Tüm menü −%5</button><button class=\"btn sm\" data-a=\"tumfiyat\" data-k=\"1.05\">Tüm menü +%5</button><button class=\"btn sm pri\" data-a=\"oneritum\">Önerileri uygula</button></div></div>`;\n}\n"],"file":"/src/ui/eco.ts"}