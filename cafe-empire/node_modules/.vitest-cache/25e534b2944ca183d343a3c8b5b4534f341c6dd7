/** Görsel coşku: konfeti, uçan sayı, titreme. Tamamen DOM + CSS (kütüphane yok). */
const root = () => document.getElementById("app") ?? document.body;
function confetti(adet = 70, renkler = [
	"#A9875E",
	"#C6A477",
	"#43A77B",
	"#6499C5",
	"#955B66",
	"#E6D6C5"
]) {
	const k = document.createElement("div");
	k.className = "confetti";
	const w = innerWidth;
	for (let i = 0; i < adet; i++) {
		const p = document.createElement("i");
		const s = 6 + Math.random() * 7;
		p.style.cssText = `left:${Math.random() * w}px;width:${s}px;height:${s * 1.6}px;background:${renkler[i % renkler.length]};animation-duration:${1.6 + Math.random() * 1.8}s;animation-delay:${Math.random() * .5}s;--dx:${(Math.random() - .5) * 220}px;--r:${Math.random() * 900}deg`;
		k.appendChild(p);
	};
	root().appendChild(k);
	setTimeout(() => k.remove(), 4200);
};
function ucanYazi(metin, x = innerWidth / 2, y = innerHeight / 2, renk = "#C6A477") {
	const e = document.createElement("div");
	e.className = "ucan";
	e.textContent = metin;
	e.style.cssText = `left:${x}px;top:${y}px;color:${renk}`;
	root().appendChild(e);
	setTimeout(() => e.remove(), 1500);
};
function titret(el) {
	if (!el) return;
	el.classList.remove("titre");
	void el.offsetWidth;
	el.classList.add("titre");
}

