	return `<svg class="yaprak" viewBox="0 0 100 100" width="${boy}" height="${boy}" aria-hidden="true"><circle cx="50" cy="50" r="${R}" fill="none" stroke="rgba(255,255,255,.1)" stroke-width="9"/><circle cx="50" cy="50" r="${R}" fill="none" stroke="#4fd6a8" stroke-width="9" stroke-linecap="round" stroke-dasharray="${d.toFixed(1)} ${(C - d).toFixed(1)}" transform="rotate(-90 50 50)" class="ghl"/><text x="50" y="47" text-anchor="middle" font-size="24" class="zip2">🌿</text><text x="50" y="68" text-anchor="middle" font-size="14" font-weight="800" fill="#4fd6a8">${Math.round(skor)}</text></svg>`;
};
/** Küçük ev (mülk). */
function ev(sahip, boy = 76) {
	return `<svg class="evs" viewBox="0 0 90 80" width="${boy}" height="${boy * .89}" aria-hidden="true"><path d="M8 40 L45 10 L82 40z" fill="${sahip ? "#d9534f" : "#8a6a45"}"/><rect x="14" y="40" width="62" height="34" fill="${sahip ? "#e8d6a8" : "#a08f78"}"/><rect x="38" y="52" width="14" height="22" fill="#6b4a2f"/><rect x="20" y="48" width="14" height="12" fill="#5fb3ff" opacity=".7"/><rect x="56" y="48" width="14" height="12" fill="#5fb3ff" opacity=".7"/>${sahip ? "<g class=\"bayrak\"><text x=\"62\" y=\"20\" font-size=\"14\">🔑</text></g>" : "<text x=\"60\" y=\"22\" font-size=\"12\">🏷️</text>"}</svg>`;
};
/** Kalkan (sigorta). */
function kalkan(plan, boy = 76) {
	const c = [
		"#6b7a82",
		"#5fb3ff",
		"#4fd6a8"
	][plan] ?? "#6b7a82";
	return `<svg class="kalkan" viewBox="0 0 64 72" width="${boy}" height="${boy * 1.12}" aria-hidden="true"><path d="M32 4 L58 13 V36 q0 22 -26 32 q-26 -10 -26 -32 V13z" fill="${c}" stroke="rgba(255,255,255,.55)" stroke-width="2.5"/><text x="32" y="46" text-anchor="middle" font-size="26">${plan === 0 ? "⚠️" : plan === 1 ? "🛡️" : "✅"}</text></svg>`;
}

