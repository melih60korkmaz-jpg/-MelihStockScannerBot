ext x=\"${W - 6}\" y=\"${H - 4}\" font-size=\"8.5\" fill=\"#86a0a6\" text-anchor=\"end\">satış payı ›</text><text x=\"4\" y=\"12\" font-size=\"8.5\" fill=\"#86a0a6\">marj ▲</text>${l.map((q, i) => `<g class=\"kabarcik\" style=\"animation-delay:${i * 0.07}s\"><circle cx=\"${x(q.pay).toFixed(1)}\" cy=\"${y(q.marj).toFixed(1)}\" r=\"${(6 + Math.sqrt(q.gelir) / 28).toFixed(1)}\" fill=\"${SR[q.sinif]}\" opacity=\".8\" stroke=\"rgba(0,0,0,.35)\"/><text x=\"${x(q.pay).toFixed(1)}\" y=\"${(y(q.marj) + 4).toFixed(1)}\" font-size=\"11\" text-anchor=\"middle\">${PRODUCT[q.id].ikon}</text></g>`).join('')}</svg>`;\n}\nexport function pSezon(): string {\n  const s = getS(), b = cur(), now = dayOf(s), ay = dateOf(now).ay, sz = sezonOf(ay), o = sezonOneri(s, b), mm = menuMuhendisligi(s, b, 30), mf = mutfakOzet(s, b), pl = pilotlar(s);\n  const urunKart = (p: (typeof PRODUCTS)[number], not = ''): string => { const a = b.menu[p.id].aktif; return `<div class=\"rowb ${a ? 'fir' : ''}\"><i>${hareketli(p.ikon)}</i><span><b>${p.ad}</b><small>${p.sezon ? 'Sezon: ' + p.sezon.map((x) => ['Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'][x]).join('–') : ''} ${not}</small></span>${a ? '<em>Menüde</em>' : `<button class=\"btn sm pri\" data-a=\"sezonUrun\" data-id=\"${p.id}\">Ekle</button>`}</div>`; };\n  const aday = PRODUCTS.filter((p) => !b.menu[p.id].aktif && !pl[p.id]?.yayildi && !p.sezon);\n  const aktifPilot = Object.entries(pl).filter(([, p]) => !p.yayildi);\n  return `${bchips()}<div class=\"cardx zafer\"><div class=\"art\"><div class=\"artbox\" style=\"width:78px;font-size:40px\"><span class=\"zip\">${sz.ik}</span></div><div style=\"flex:1\"><div class=\"tiny muted\">ŞİMDİKİ SEZON</div><h3>${sz.ad} menüsü</h3><div class=\"small muted\">Sonraki sezona ${sezonKalan(s)} gün · ${SEZONLAR[(SEZONLAR.findIndex((x) => x.id === sz.id) + 1) % 4]!.ad}</div></div></div><div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm pri\" data-a=\"sezonAc\">🍂 Sezon ürünlerini menüye ekle (${o.ac.length})</button><button class=\"btn sm\" data-a=\"sezonKapat\">Sezon dışını çıkar (${o.kapat.length})</button></div></div>\n  <div class=\"duo\"><div class=\"duoL\"><div class=\"cardx\"><b>Bu sezonun ürünleri</b><div class=\"rows\" style=\"margin-top:6px\">${sezonUrunleri(ay).map((p) => urunKart(p, '· şimdi ×1,6 talep')).join('') || '<div class=\"small muted\">Bu ay özel sezon ürünü yok.</div>'}</div>${o.yaklasan.length ? `<div class=\"tiny muted\" style=\"margin-top:8px\">⏭️ Yaklaşan sezon ürünleri (önceden deneyebilirsin):</div><div class=\"rows\">${o.yaklasan.map((p) => urunKart(p)).join('')}</div>` : ''}${o.kapat.length ? `<div class=\"tiny badc\" style=\"margin-top:8px\">⚠️ Sezon dışı ve menüde: ${o.kapat.map((p) => p.ad).join(', ')} (talep ×0,12).</div>` : ''}</div>\n  <div class=\"cardx\"><b>🧪 Pilot şube</b><div class=\"tiny muted\">Yeni ürünü önce tek şubede ${PILOT_GUN} gün dene; tutarsa tüm şubelere yay.</div>${aktifPilot.map(([id, p]) => { const pr = PRODUCT[id as ProductId], sb = s.subeler.find((x) => x.id === p.sube); return `<div class=\"cardx\" style=\"margin:8px 0 0;padding:8px\"><div class=\"row small\"><b>${pr.ikon} ${pr.ad}</b><span>${esc(sb?.ad ?? '')}</span></div>${p.bitti ? `<div class=\"small ${p.iyi ? 'good' : 'badc'}\">${p.iyi ? '✅ Tuttu' : '❌ Zayıf'} · günde ${tr(p.gunAdet ?? 0, 1)} adet · müşteri payı %${Math.round((p.pay ?? 0) * 100)}</div>${p.iyi ? `<button class=\"btn sm pri\" data-a=\"pilotYay\" data-id=\"${id}\">Tüm şubelere yay</button>` : '<div class=\"tiny muted\">İstersen menüden çıkarabilirsin.</div>'}` : `${bar(p.gun / PILOT_GUN * 100, 'var(--am)')}<div class=\"tiny muted\">${p.gun}/${PILOT_GUN} gün · şimdiye kadar ${p.adet} adet</div>`}</div>`; }).join('')}<div class=\"tiny muted\" style=\"margin-top:8px\">Pilota alınacak ürün:</div><div class=\"chiprow\">${aday.slice(0, 14).map((p) => `<button class=\"cx ${secim === p.id ? 'on' : ''}\" data-a=\"pilotSec\" data-id=\"${p.id}\">${p.ikon} ${p.ad}</button>`).join('') || '<span class=\"small muted\">Menüde olmayan ürün kalmadı.</span>'}</div><button class=\"btn sm pri\" data-a=\"pilotBasla\" style=\"margin-top:6px\" ${secim ? '' : 'disabled'}>Pilotu başlat</button></div></div>\n  <div class=\"duoR\"><div class=\"cardx\"><b>📐 Menü mühendisliği (30 gün)</b>${sacilim(mm)}<div class=\"tiny muted\">Yatay: satış payı · dikey: adet başı marj · baloncuk: ciro. Kesikli çizgi: ortalama pay.</div>${mm.map((x) => { const sn = MENU_SINIF[x.sinif]; return `<div class=\"row small\" style=\"margin-top:6px\"><span>${sn.ik} ${PRODUCT[x.id].ikon} ${PRODUCT[x.id].ad}</span><b>${x.adet} adet · ${tr(x.marj, 0)} ₺ marj</b></div><div class=\"tiny muted\">${sn.ad}: ${sn.ac}</div>`; }).join('')}</div>\n  <div class=\"cardx\"><b>🍳 Mutfak</b><div class=\"row small\"><span>Bugünkü toplam hazırlık</span><b>${tr(mf.toplamDk, 0)} dk</b></div><div class=\"row small\"><span>Fire (bozulma) · son 30 gün</span><b class=\"${mf.fire30 > 5000 ? 'badc' : 'good'}\">${fmt(mf.fire30)}</b></div><div class=\"tiny muted\" style=\"margin-top:6px\">Taze ürünler</div>${mf.taze.map((t) => `<div class=\"row small\"><span>${t.ik} ${esc(t.ad)}</span><b class=\"${t.risk ? 'badc' : ''}\">${t.gun === null ? '—' : `${t.gun} gün kaldı`}${t.risk ? ' ⚠️ bozulabilir' : ''}</b></div>`).join('')}<div class=\"tiny muted\" style=\"margin-top:6px\">En uzun hazırlanan ürünler</div>${mf.hazirlik.slice(0, 5).map((x) => `<div class=\"row small\"><span>${PRODUCT[x.id].ikon} ${x.ad} (${x.sure} sn)</span><b>${tr(x.toplamDk, 0)} dk</b></div>${bar(x.toplamDk / Math.max(1, mf.hazirlik[0]!.toplamDk) * 100, 'var(--am)')}`).join('')}</div></div></div>`;\n}\nexport function handleSezon(a: string, d: DOMStringMap, h: Helpers): boolean {\n  const s = getS(), b = cur(), R = (r: { ok: boolean; m: string }): boolean => { h.res(r); h.refresh(); return true; };\n  switch (a) {\n    case 'sezonAc': return R(sezonMenuAc(s, b)); case 'sezonKapat': return R(sezonDisiKapat(s, b)); case 'sezonUrun': return R(toggleProduct(s, b, d.id as ProductId));\n    case 'pilotSec': secim = d.id as ProductId; h.refresh(); return true; case 'pilotBasla': { if (!secim) return true; const r = pilotBaslat(s, b, secim); if (r.ok) secim = null; return R(r); } case 'pilotYay': return R(pilotYay(s, d.id as ProductId));\n    default: return false;\n  }\n}\n"],"file":"/src/ui/sezon.ts"}