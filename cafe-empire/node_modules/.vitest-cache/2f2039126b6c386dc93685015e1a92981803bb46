rif' | 'harman', fuarStant));\n    case 'esnafZiyaret': return b ? R(esnafZiyaret(s, b, dd.id!)) : true; case 'esnafOrtak': return b ? R(ortakKampanya(s, b, dd.id!)) : true;\n    case 'casus': return R(casusluk(s, dd.id!)); case 'frsoz': frSoz.v = dd.v as SozlesmeId; h.refresh(); return true;\n    default: return false;\n  }\n}\nvoid stat; void kisa; void mudavimSayi; void yildiz;\n"],"file":"/src/ui/derin.ts"}