GAAG,CAAC,CAAC,CAAC;EAC9N,KAAK,WAAW,OAAO,EAAE,sCAAY,GAAG,IAAI,GAAG,EAAE,GAAG,GAAG,CAAkC,CAAC;EAAG,KAAK,YAAY,OAAO,EAAE,yCAAe,GAAG,IAAI,GAAG,EAAE,CAAC,CAAC;EACpJ,KAAK;GAAa,YAAY,GAAG,MAAM,MAAM,IAAI;GAAG,EAAE,QAAQ;GAAG,OAAO;EAAM,KAAK,aAAa,OAAO,EAAE,oCAAU,GAAG,GAAG,GAAyB,SAAS,CAAC;EAC5J,KAAK,gBAAgB,OAAO,IAAI,EAAE,uCAAa,GAAG,GAAG,GAAG,EAAG,CAAC,IAAI;EAAM,KAAK,cAAc,OAAO,IAAI,EAAE,wCAAc,GAAG,GAAG,GAAG,EAAG,CAAC,IAAI;EACrI,KAAK,SAAS,OAAO,EAAE,mCAAS,GAAG,GAAG,EAAG,CAAC;EAAG,KAAK;GAAS,MAAM,IAAI,GAAG;GAAiB,EAAE,QAAQ;GAAG,OAAO;EAC7G,SAAS,OAAO;CAClB;AACF;AACA,KAAK;AAAM,KAAK;AAAM,KAAK;AAAa,KAAK","names":[],"ignoreList":[],"sources":["derin.ts"],"sourcesContent":["/** Derin sistemlerin sayfaları: Atölye (çekirdek, tarif, ustalık, fuar) ve Semt (takvim, müdavim, esnaf, rakipler, hikâye). */\nimport { cityById } from '../data/turkey';\nimport { PRODUCT } from '../data/catalog';\nimport { fmt, type Result } from '../core/actions';\nimport { dayOf, dateOf } from '../core/calendar';\nimport { ctx, cur, esc, bar, tr, stat, bchips, S as getS, type Helpers } from './panels';\nimport { D, CEKIRDEKLER, KAVURMA, harman, harmanUyum, cekirdekAyarla, SUTLER, SUPLAR, SOSLAR, tarifMaliyet, tarifTahmin, tarifOlustur, tarifTat, tarifImza, tarifSil, tarifFiyat, YETENEKLER, ustaOf, ustaSeviye, ustaPuan, UNVAN, ustaYetenek, sampiyonaKatil, takvim, mudavimSayi, musteriTipleri, SEG_NOT, esnafOf, esnafIliski, esnafZiyaret, ortakKampanya, kimlik, karakterOf, KARAKTERLER, KISILIK_AD, casusluk, fuarDurum, fuarKayit, SOZLESME, type SozlesmeId, MUD_MAX, type Tarif } from '../core/derin';\n\nconst kisa = (v: number): string => (Math.abs(v) >= 1e6 ? `${tr(v / 1e6)} Mn` : Math.abs(v) >= 1e3 ? `${Math.round(v / 1e3)} B` : String(Math.round(v)));\nconst tf = { ad: '', sut: 0, sup: 1, sos: 0, soguk: false, shot: 1 };\nlet fuarStant: 0 | 1 = 0;\nexport const frSoz = { v: 'standart' as SozlesmeId };\nconst chips = (items: Array<[string, string, boolean]>, a: string, k = ''): string => `<div class=\"chiprow\" style=\"margin:4px 0\">${items.map(([v, ad, on]) => `<button class=\"cx ${on ? 'on' : ''}\" data-a=\"${a}\" data-k=\"${k}\" data-v=\"${v}\">${ad}</button>`).join('')}</div>`;\nconst yildiz = (n: number): string => '★'.repeat(Math.round(n / 20)) + '☆'.repeat(5 - Math.round(n / 20));\n\n/* ---------- Atölye ---------- */\nfunction pCek(): string {\n  const s = getS(), d = D(s), h = harman(s), c = d.cek, A = CEKIRDEKLER.find((x) => x.id === c.ana)!, K = KAVURMA[c.kavurma]!;\n  const ay = dateOf(dayOf(s)).ay;\n  return `<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx\"><div class=\"tiny muted\">AKTİF KARIŞIM</div><h3>☕ ${esc(c.ad)}</h3><div class=\"row small\"><span>Kalite çarpanı</span><b class=\"${h.kal >= 1 ? 'good' : 'badc'}\">×${tr(h.kal, 3)}</b></div><div class=\"row small\"><span>Maliyet çarpanı (kahve malzemesi)</span><b class=\"${h.mal <= 1 ? 'good' : 'badc'}\">×${tr(h.mal, 2)}</b></div><div class=\"row small\"><span>Harman uyumu</span><b class=\"${h.uyum > 0 ? 'good' : h.uyum < 0 ? 'badc' : ''}\">${h.uyum > 0 ? '+' : ''}${tr(h.uyum * 100, 0)} puan</b></div>${c.gecis > 0 ? `<div class=\"tiny badc\">Fırın ısınıyor: ${c.gecis} gün kalite −%3</div>` : ''}<div class=\"small muted\" style=\"margin-top:6px\">${esc(A.not)} · ${K.ad} kavurma: ${K.not}</div><div style=\"display:flex;gap:6px;margin-top:8px\"><input class=\"kin\" id=\"cekAd\" value=\"${esc(c.ad)}\" maxlength=\"24\" style=\"flex:1;margin:0\"><button class=\"btn sm\" data-a=\"cekAd\">Adı kaydet</button></div></div>\n  <div class=\"cardx small muted\">Karışımı değiştirmek 4 B ₺ tutar ve 3 gün geçiş cezası getirir. Hasat mevsiminde ham çekirdek %7 ucuzlar. Kaliteli karışım memnuniyeti ve yorum puanını yükseltir, ama maliyetini her gün ödersin.</div></div>\n  <div class=\"duoR\"><div class=\"cardx\"><b>Ana çekirdek</b>${CEKIRDEKLER.map((x) => `<button class=\"rowb ${c.ana === x.id ? 'fir' : ''}\" data-a=\"cekSet\" data-k=\"ana\" data-v=\"${x.id}\"><i>🫘</i><span><b>${x.ad}</b><small>${x.not} Hasat: ${x.hasat.includes(ay) ? '<b class=\"good\">şimdi</b>' : 'sezon dışı'}</small></span><em>K ${tr(x.kal, 2)} · M ${tr(x.mal, 2)}</em></button>`).join('')}</div>\n  <div class=\"cardx\"><b>İkinci çekirdek (harman)</b>${chips([['yok', 'Yok', !c.ikinci], ...CEKIRDEKLER.filter((x) => x.id !== c.ana).map((x): [string, string, boolean] => [x.id, `${x.ad.split(' ')[0]} ${harmanUyum(c.ana, x.id) > 0 ? '✨' : harmanUyum(c.ana, x.id) < 0 ? '⚠️' : ''}`, c.ikinci === x.id])], 'cekSet', 'ikinci')}${c.ikinci ? `<div class=\"tiny muted\">İkinci çekirdek oranı (en uyumlu: %20–50)</div>${chips([10, 20, 30, 40, 50, 60].map((o): [string, string, boolean] => [String(o / 100), `%${o}`, Math.round(c.oran * 100) === o]), 'cekSet', 'oran')}` : ''}<b style=\"display:block;margin-top:8px\">Kavurma</b>${chips(KAVURMA.map((x, i): [string, string, boolean] => [String(i), x.ad, c.kavurma === i]), 'cekSet', 'kavurma')}</div></div></div>`;\n}\nfunction tarifKart(s: ReturnType<typeof getS>, t: Tarif): string {\n  const d = D(s), e = tarifTahmin(s, t), mal = tarifMaliyet(s, t), imza = d.imza === t.id;\n  return `<div class=\"cardx ${imza ? 'kasa' : ''}\"><div class=\"row\"><b>${imza ? '⭐ ' : ''}${esc(t.ad)}</b><span class=\"pill\">${t.soguk ? '🧊 soğuk' : '🔥 sıcak'}</span></div><div class=\"tiny muted\">${SUTLER[t.sut]} · ${SUPLAR[t.sup]} · ${SOSLAR[t.sos]} · ${t.shot} shot</div><div class=\"row small\"><span>Müşteri puanı (tahmin)</span><b>${t.test ? `${e.orta}/100 ±${e.pay}` : 'bilinmiyor — tattır'}</b></div>${t.test ? bar(e.orta, 'var(--am)') : ''}<div class=\"row small\"><span>Maliyet · satış fiyatı</span><b>${tr(mal, 1)} ₺ · <span class=\"stp\" style=\"display:inline-flex\"><button data-a=\"tarifFiyat\" data-id=\"${t.id}\" data-d=\"-5\">−</button> ${t.fiyat} ₺ <button data-a=\"tarifFiyat\" data-id=\"${t.id}\" data-d=\"5\">+</button></span></b></div>${t.satis > 0 ? `<div class=\"row small\"><span>Satılan · gelir</span><b>${Math.round(t.satis)} adet · ${fmt(t.gelir)}</b></div>` : ''}<div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm\" data-a=\"tarifTat\" data-id=\"${t.id}\">Tattır (${t.test})</button><button class=\"btn sm ${imza ? 'on' : 'pri'}\" data-a=\"tarifImza\" data-id=\"${t.id}\" ${imza ? 'disabled' : ''}>${imza ? 'İmza içecek' : 'İmza yap (8 B ₺)'}</button><button class=\"btn sm bad\" data-a=\"tarifSil\" data-id=\"${t.id}\">Sil</button></div></div>`;\n}\nfunction pTarif(): string {\n  const s = getS(), d = D(s);\n  const form = `<div class=\"cardx\"><b>Yeni tarif yaz</b><input class=\"kin\" id=\"tarifAd\" placeholder=\"Tarifin adı\" value=\"${esc(tf.ad)}\" maxlength=\"22\"><div class=\"tiny muted\">Süt</div>${chips(SUTLER.map((x, i): [string, string, boolean] => [String(i), x, tf.sut === i]), 'tfSet', 'sut')}<div class=\"tiny muted\">Şurup</div>${chips(SUPLAR.map((x, i): [string, string, boolean] => [String(i), x, tf.sup === i]), 'tfSet', 'sup')}<div class=\"tiny muted\">Sos</div>${chips(SOSLAR.map((x, i): [string, string, boolean] => [String(i), x, tf.sos === i]), 'tfSet', 'sos')}<div class=\"tiny muted\">Servis · shot</div>${chips([['0', '🔥 Sıcak', !tf.soguk], ['1', '🧊 Soğuk', tf.soguk]], 'tfSet', 'soguk')}${chips([['1', '1 shot', tf.shot === 1], ['2', '2 shot', tf.shot === 2]], 'tfSet', 'shot')}<div class=\"row small\"><span>Tahmini maliyet</span><b>${tr(tarifMaliyet(s, tf), 1)} ₺</b></div><button class=\"ybtn big\" data-a=\"tarifYeni\">Tarifi yaz<small>−${fmt(2500 * s.market.fiyat)}</small></button></div>`;\n  return `<div class=\"duo\"><div class=\"duoL\">${d.tarif.map((t) => tarifKart(s, t)).join('') || '<div class=\"cardx small muted\">Henüz tarifin yok. Sağdan içecek tasarla; tattırarak müşteri puanını tahmin et, beğenileni imza içecek yap.</div>'}</div><div class=\"duoR\">${form}<div class=\"cardx small muted\">Gizli beğeni; her tadımda tahmin netleşir. Soğuk içecekler yazın, sıcaklar kışın çok satar. İmza içecek her şubede ek satış yaratır ve fuarda yarışır.</div></div></div>`;\n}\nfunction pUsta(): string {\n  const s = getS(), b = cur(), d = D(s), ekim = dateOf(dayOf(s)).ay === 9, yil = dateOf(dayOf(s)).yil;\n  const bar_ = b.staff.filter((e) => e.tip === 'barista');\n  const kart = bar_.map((e) => { const u = ustaOf(s, e), sv = ustaSeviye(u), k = karakterOf(s, e); return `<div class=\"cardx\"><div class=\"row\"><b>👤 ${esc(e.ad)}</b><span class=\"pill\">${UNVAN(sv)} · ${sv}. seviye</span></div><div class=\"tiny muted\">${k.ik} ${k.ad} — ${k.not}</div>${bar(u.xp / 256 * 100, 'var(--am)')}<div class=\"tiny muted\">Deneyim ${Math.round(u.xp)} · harcanabilir puan <b>${ustaPuan(u)}</b></div>${YETENEKLER.map((y) => `<div class=\"row small\"><span>${y.ad} <span class=\"tiny muted\">(${y.ac})</span></span><b>${'●'.repeat(u[y.id])}${'○'.repeat(5 - u[y.id])} <button class=\"btn sm\" data-a=\"ustaYet\" data-id=\"${e.id}\" data-y=\"${y.id}\">+</button></b></div>`).join('')}<button class=\"btn sm ${ekim ? 'pri' : ''}\" data-a=\"samKatil\" data-id=\"${e.id}\" style=\"margin-top:6px\">🏆 Şampiyonaya sok (8 B ₺)</button></div>`; }).join('');\n  return `${bchips()}<div class=\"duo\"><div class=\"duoL\">${kart || '<div class=\"cardx small muted\">Bu şubede barista yok. Personel sayfasından işe al.</div>'}</div><div class=\"duoR\"><div class=\"cardx\"><b>🏆 Barista şampiyonası</b><div class=\"tiny muted\">Her yıl Ekim ayında. ${ekim ? '<b class=\"good\">Bu ay kayıt açık!</b>' : 'Ekim ayını bekle.'} (${yil}: ${d.sam.some((x) => x.yil === yil) ? 'katıldın' : 'katılmadın'})</div>${d.sam.map((x) => `<div class=\"row small\"><span>${x.yil}</span><b>${esc(x.ad)}</b></div>`).join('') || '<div class=\"tiny muted\">Geçmiş sonuç yok.</div>'}</div><div class=\"cardx small muted\">Barista her gün deneyim kazanır. Her seviye 1 yetenek puanı verir. Latte art ürün kalitesini, sohbet talebi, israfsız çalışma malzeme giderini iyileştirir. Hırslı karakterler daha hızlı gelişir. Şampiyon barista markana prestij ve 2 ay talep artışı getirir.</div></div></div>`;\n}\nfunction pFuar(): string {\n  const s = getS(), d = D(s), du = fuarDurum(s), h = harman(s), imza = d.tarif.find((x) => x.id === d.imza), kayitli = d.fuar.kayit?.yil === du.yil;\n  const asama = du.asama === 'fuar' ? '🎪 Fuar bugün açık!' : du.asama === 'kayit' ? `📝 Kayıt açık — fuara ${du.kalan} gün` : `⏳ Fuara ${du.kalan} gün (Nisan 10–12), kayıt 15 Mart'ta`;\n  return `<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx kasa\"><div class=\"tiny muted\">ULUSAL KAHVE FUARI</div><h3>${asama}</h3>${kayitli ? `<div class=\"small good\">✓ Kayıtlısın: ${esc(d.fuar.kayit!.ad)} (${d.fuar.kayit!.tur === 'tarif' ? 'imza tarif' : 'harman'}) · ${d.fuar.kayit!.stant ? 'büyük stant' : 'küçük stant'}</div>` : du.asama === 'kayit' ? `<div class=\"tiny muted\">Ne ile yarışacaksın?</div><div class=\"chiprow\"><button class=\"btn sm\" data-a=\"fuarStant\" data-v=\"0\">${fuarStant === 0 ? '✓ ' : ''}Küçük stant (6 B)</button><button class=\"btn sm\" data-a=\"fuarStant\" data-v=\"1\">${fuarStant === 1 ? '✓ ' : ''}Büyük stant (15 B)</button></div><div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm pri\" data-a=\"fuarKayit\" data-t=\"tarif\" ${imza ? '' : 'disabled'}>İmza tarif: ${imza ? esc(imza.ad) : 'yok'}</button><button class=\"btn sm pri\" data-a=\"fuarKayit\" data-t=\"harman\">Harman: ${esc(h.ad)}</button></div>` : '<div class=\"small muted\">Kayıt dönemi dışında. Önceden imza içecek ve harmanını hazırla.</div>'}</div><div class=\"cardx\"><b>🥇 Kupa dolabı</b><div class=\"para sm\">${d.fuar.kupa} altın</div>${d.fuar.gecmis.map((x) => `<div class=\"row small\"><span>${x.yil}</span><b>${x.derece}</b></div>`).join('') || '<div class=\"tiny muted\">Henüz fuara katılmadın.</div>'}</div></div><div class=\"duoR\"><div class=\"cardx small muted\"><b>Puan nasıl hesaplanır?</b><br>Ürün kalitesi (imza tarifin müşteri puanı ya da harman kalitesi) %70, barista latte art ustalığı, marka puanın ve stant büyüklüğü eklenir. Rakip zincirler de yarışır; güçlenen rakip zor rakip demektir.<br><br>Altın: 50 B ₺ + marka +8 + 45 gün talep +%10 · Gümüş: 25 B ₺ + marka +5 · Bronz: 10 B ₺ + marka +3. Stant satışları ayrıca etkinlik geliri olarak yazılır.</div></div></div>`;\n}\n\n/* ---------- Semt ---------- */\nfunction pTakvim(): string {\n  const s = getS(), b = cur(), k = kimlik(s, b), tk = takvim(s, b, 14), now = dayOf(s);\n  return `${bchips()}<div class=\"cardx\"><div class=\"row\"><b>${k.ik} ${esc(b.ad)}</b><span class=\"pill\">${k.ad}</span></div><div class=\"tiny muted\">Yaklaşan semt olayları ve talebe etkileri. Olay günü sana hazırlık sorulur.</div></div><div class=\"rows\">${tk.map((x) => { const dt = dateOf(x.gun); return `<div class=\"rowb ${x.olaylar.length ? 'fir' : ''}\"><i>${x.olaylar[0]?.ikon ?? '·'}</i><span><b>${x.gun === now ? 'Bugün' : `${dt.ayGun} ${dt.ayAdi}`}</b><small>${x.olaylar.map((o) => `${o.ad} ${o.talep >= 1 ? '+' : ''}${Math.round((o.talep - 1) * 100)}%`).join(' · ') || 'Normal gün'}</small></span></div>`; }).join('')}</div>`;\n}\nfunction pMudavim(): string {\n  const s = getS(), b = cur(), d = D(s), l = d.mud[b.id] ?? [], tip = musteriTipleri(b);\n  return `${bchips()}<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx\"><b>👥 Müşteri tipleri</b>${tip.map((x) => `<div class=\"row small\"><span><b>${x.ad}</b> %${Math.round(x.pay * 100)}</span></div>${bar(x.pay * 100, 'var(--am)')}<div class=\"tiny muted\">${SEG_NOT[x.id]}</div>`).join('')}</div></div><div class=\"duoR\"><div class=\"cardx\"><b>☕ Müdavimler (${l.length}/${MUD_MAX})</b><div class=\"tiny muted\">Memnun müşteri sadık müdavime dönüşür; favori ürünü bulunmazsa ya da pahalıysa küser.</div>${l.map((m) => `<div class=\"row small\"><span>${esc(m.ad)} <span class=\"tiny muted\">${PRODUCT[m.urun].ad}</span></span><b>${Math.round(m.bag)}</b></div>${bar(m.bag, m.bag >= 60 ? 'var(--ok)' : 'var(--am)')}`).join('') || '<div class=\"small muted\" style=\"margin-top:6px\">Henüz müdavimin yok: memnuniyeti artır, favori ürünleri aktif tut.</div>'}</div></div></div>`;\n}\nfunction pEsnaf(): string {\n  const s = getS(), b = cur(), d = D(s), now = dayOf(s);\n  return `${bchips()}<div class=\"rows\">${esnafOf(s, b).map((e) => { const r = esnafIliski(s, b, e.id), aktif = (d.ortak[b.id]?.[e.id] ?? 0) > now; return `<div class=\"cardx\"><div class=\"row\"><b>${e.ikon} ${e.ad}</b><span class=\"pill\">${aktif ? `ortak kampanya · ${(d.ortak[b.id]![e.id]!) - now} gün` : `ilişki ${Math.round(r)}`}</span></div><div class=\"tiny muted\">${e.not}</div>${bar(r, r >= 60 ? 'var(--ok)' : 'var(--am)')}<div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm\" data-a=\"esnafZiyaret\" data-id=\"${e.id}\">Ziyaret et (1,5 B)</button><button class=\"btn sm pri\" data-a=\"esnafOrtak\" data-id=\"${e.id}\">Ortak kampanya (4 B)</button></div></div>`; }).join('')}</div><div class=\"cardx small muted\">İlişki 60 üstündeyse esnaf müşteri yönlendirir (talep +%${'2–3'}); ortak kampanya 14 gün ek talep sağlar. İlişki zamanla soğur; ara ara uğra.</div>`;\n}\nfunction pRakipler(): string {\n  const s = getS(), d = D(s), now = dayOf(s);\n  return `<div class=\"cards2\">${d.rakip.map((r) => { const goz = now - r.casus <= 20; return `<div class=\"cardx\"><div class=\"row\"><b>🏢 ${esc(r.ad)}</b><span class=\"pill\">${KISILIK_AD[r.kisilik]}</span></div><div class=\"tiny muted\">“${esc(r.slogan)}”</div><div class=\"row small\"><span>Şehir sayısı</span><b>${r.sehirler.length}${r.sehirler.length ? ' · ' + r.sehirler.slice(0, 4).map((c) => cityById(c).ad).join(', ') : ''}</b></div><div class=\"row small\"><span>Güç</span><b>${goz ? tr(r.guc, 2) : '??'}</b></div><div class=\"small muted\">Son hamle: ${esc(r.son)}</div>${goz ? '<div class=\"tiny good\">Gizli müşteri raporu aktif (20 gün)</div>' : ''}<button class=\"btn sm\" data-a=\"casus\" data-id=\"${r.id}\" style=\"margin-top:6px\">Gizli müşteri gönder (6 B)</button></div>`; }).join('')}</div><div class=\"cardx small muted\">Zincirler zamanla şubelerinin olduğu şehirlere girer. Agresif olan fiyat kırar ve barista kapmaya çalışır; kalite odaklı olan fuarda yarışır. Fuarda güçlenen rakip altın madalya için zor rakiptir.</div>`;\n}\nfunction pHikaye(): string {\n  const s = getS(), b = cur(), d = D(s), k = kimlik(s, b), l = d.hik[b.id] ?? [], g = d.hik[0] ?? [];\n  return `${bchips()}<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx\"><div class=\"tiny muted\">DÜKKÂNIN KİMLİĞİ</div><h3>${k.ik} ${k.ad}</h3><div class=\"small muted\">${esc(b.ad)} · ${cityById(b.city).ad} · ${Math.max(0, dayOf(s) - b.acilis)} gündür açık</div></div><div class=\"cardx\"><b>⭐ Dükkân günlüğü</b>${l.map((x) => `<div class=\"small\" style=\"padding:4px 0;border-top:1px solid var(--line)\">${esc(x)}</div>`).join('') || '<div class=\"small muted\">Henüz kayıt yok; ilk müşteriler gelsin…</div>'}</div></div><div class=\"duoR\"><div class=\"cardx\"><b>👥 Ekibin karakterleri</b>${b.staff.map((e) => { const kr = karakterOf(s, e); return `<div class=\"row small\"><span>${kr.ik} ${esc(e.ad)}</span><b>${kr.ad}</b></div><div class=\"tiny muted\">${kr.not}</div>`; }).join('') || '<div class=\"small muted\">Ekip yok.</div>'}<div class=\"tiny muted\" style=\"margin-top:6px\">${KARAKTERLER.length} karakter türü var; zam isteği, istifa ve kalite etkileri karaktere göre değişir.</div></div><div class=\"cardx\"><b>📰 Şirket günlüğü</b>${g.slice(0, 10).map((x) => `<div class=\"small\" style=\"padding:3px 0;border-top:1px solid var(--line)\">${esc(x)}</div>`).join('') || '<div class=\"small muted\">Henüz haber yok.</div>'}</div></div></div>`;\n}\nexport const DERIN_PAGES: Record<string, () => string> = { cek: pCek, tarif: pTarif, usta: pUsta, fuar: pFuar, takvim: pTakvim, mudavim: pMudavim, esnaf: pEsnaf, rakipler: pRakipler, hikaye: pHikaye };\n\n/* ---------- Franchise sözleşme seçici ---------- */\nexport function sozlesmeHtml(): string {\n  return `<div class=\"tiny muted\" style=\"margin-top:6px\">Sözleşme türü</div><div class=\"chiprow\" style=\"margin:4px 0\">${(Object.keys(SOZLESME) as SozlesmeId[]).map((id) => `<button class=\"cx ${frSoz.v === id ? 'on' : ''}