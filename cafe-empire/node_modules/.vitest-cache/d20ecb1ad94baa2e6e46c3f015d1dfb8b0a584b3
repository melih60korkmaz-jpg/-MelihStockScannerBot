/* ===================== Takvim ===================== */
const MIN_PER_DAY = 1440;
const MONTH_DAYS = [
	31,
	28,
	31,
	30,
	31,
	30,
	31,
	31,
	30,
	31,
	30,
	31
];
const MONTH_NAMES = [
	"Ocak",
	"Şubat",
	"Mart",
	"Nisan",
	"Mayıs",
	"Haziran",
	"Temmuz",
	"Ağustos",
	"Eylül",
	"Ekim",
	"Kasım",
	"Aralık"
];
const START_MONTH = 2;
const START_YEAR = 2027;
function dateOf(gun) {
	let m = START_MONTH, y = START_YEAR, d = gun;
	for (;;) {
		const n = m === 1 && y % 4 === 0 ? 29 : MONTH_DAYS[m] ?? 30;
		if (d < n) break;
		d -= n;
		m++;
		if (m > 11) {
			m = 0;
			y++;
		}
	};
	return {
		ay: m,
		ayGun: d + 1,
		yil: y,
		haftaGun: (gun + 0) % 7,
		ayAdi: MONTH_NAMES[m] ?? ""
	};
};
const dayOf = (s) => Math.floor(s.dk / MIN_PER_DAY);
const hourOf = (s) => s.dk % MIN_PER_DAY / 60;
const dateText = (s) => {
	const d = dateOf(dayOf(s));
	return `${d.ayGun} ${d.ayAdi} ${d.yil}`;
};
const timeText = (s) => {
	const h = Math.floor(hourOf(s)), m = Math.floor((hourOf(s) - h) * 60 / 10) * 10;
	return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
};

