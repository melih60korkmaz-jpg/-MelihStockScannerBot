); } else h.res(r); return true; }\n    case 'subeAcik': ctx.subeAcik = +d.id!; ctx.bid = +d.id!; ctx.subeSekme = 'ozet'; h.go('subeler'); return true;\n    case 'subeGeri': ctx.subeAcik = null; h.refresh(); return true;\n    case 'subeSekme': ctx.subeSekme = d.k as typeof ctx.subeSekme; ctx.anim = true; h.refresh(); return true;\n    case 'platKatil': h.res(platformaKatil(s, cur(), d.id!)); return true;\n    case 'platCik': h.res(platformdanCik(cur(), d.id!)); return true;\n    case 'paylas': h.res(paylas(s, d.id!)); return true;\n    case 'ajans': h.res(ajansToggle(s)); return true;\n    case 'sirTab': ctx.sirTab = d.k as 'zincir' | 'sehir'; h.refresh(); return true;\n    case 'banka': h.res(krediCek(s, d.b!, +d.n!)); return true;\n    default: return false;\n  }\n}\nvoid ok; void no; void closeBranch; void payLoan; void ilAc; void ilAcik; void setupCost; void yl; void stat; void esc; void CITIES; void NAT_VB; void ilceOf;\n"],"file":"/src/ui/pages.ts"}