ring): Result => ({ ok: true, m }), no = (m: string): Result => ({ ok: false, m });\nconst bosKart = (m: string): string => `<div class=\"empty\"><div class=\"eico\">🏪</div><b>Henüz şuben yok</b><div class=\"small muted\">${m}</div><button class=\"btn pri\" data-a=\"git\" data-t=\"harita\">Şube kur ›</button></div>`;\n\n/* ===================== Dükkân resmi (statik, 2B) ===================== */\nexport function dukkanSvg(s: GameState, b: Branch | null): string {\n  const saat = hourOf(s), gece = saat < 6 || saat >= 19, gok = gece ? ['#12172b', '#1d2547'] : saat < 8 || saat >= 17 ? ['#ffb36b', '#ffe3b0'] : ['#8cc4f0', '#dff0ff'];\n  const sky = `<defs><linearGradient id=\"gk\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"${gok[0]}\"/><stop offset=\"1\" stop-color=\"${gok[1]}\"/></linearGradient></defs><rect width=\"320\" height=\"170\" fill=\"url(#gk)\"/>${gece ? '<circle cx=\"268\" cy=\"30\" r=\"9\" fill=\"#f3f0d0\"/>' : '<circle cx=\"268\" cy=\"34\" r=\"11\" fill=\"#fff3a8\"/>'}<rect x=\"0\" y=\"40\" width=\"60\" height=\"100\" fill=\"${gece ? '#1a2038' : '#9fb4c8'}\"/><rect x=\"262\" y=\"55\" width=\"58\" height=\"85\" fill=\"${gece ? '#1a2038' : '#9fb4c8'}\"/><rect x=\"0\" y=\"138\" width=\"320\" height=\"32\" fill=\"${gece ? '#222633' : '#6b7280'}\"/><rect x=\"0\" y=\"138\" width=\"320\" height=\"4\" fill=\"${gece ? '#343a4d' : '#9aa0ab'}\"/>`;\n  if (!b) return `<svg viewBox=\"0 0 320 170\" class=\"dsvg\">${sky}<rect x=\"70\" y=\"52\" width=\"180\" height=\"88\" fill=\"#3a3d46\"/><rect x=\"82\" y=\"64\" width=\"34\" height=\"34\" fill=\"#252830\"/><rect x=\"204\" y=\"64\" width=\"34\" height=\"34\" fill=\"#252830\"/><rect x=\"128\" y=\"86\" width=\"64\" height=\"54\" fill=\"#2c2f38\"/><rect x=\"60\" y=\"44\" width=\"200\" height=\"10\" fill=\"#4b4f5c\"/><path d=\"M80 120 L240 100 L240 108 L80 128Z\" fill=\"#e8c840\"/><path d=\"M82 119l8-3v10l-8 3zM110 115l8-3v10l-8 3zM138 111l8-3v10l-8 3z\" fill=\"#222\"/><rect x=\"104\" y=\"104\" width=\