QAAQ;GAAG,CAAC;GAAG,OAAO;EAAM;EACtT,KAAK;GAAc,4BAAE,CAAC,CAAC,CAAC,MAAM,GAAG,KAAM;GAAG,EAAE,QAAQ;GAAG,OAAO;EAC9D,KAAK;GAAa,YAAY,GAAG,MAAM,MAAM,IAAI;GAAG,EAAE,QAAQ;GAAG,OAAO;EAAM,KAAK,aAAa;GAAE,MAAM,MAAM,GAAG;GAAyB,SAAS,+BAA+B,OAAO;IAAE,EAAE,IAAI,oCAAU,GAAG,KAAK,WAAW,EAAE,CAAC;IAAG,EAAE,QAAQ;GAAG,CAAC;GAAG,OAAO;EAAM;EAClQ,KAAK,gBAAgB,OAAO,IAAI,EAAE,uCAAa,GAAG,GAAG,GAAG,EAAG,CAAC,IAAI;EAAM,KAAK,cAAc,OAAO,IAAI,EAAE,wCAAc,GAAG,GAAG,GAAG,EAAG,CAAC,IAAI;EACrI,KAAK,SAAS,OAAO,EAAE,mCAAS,GAAG,GAAG,EAAG,CAAC;EAAG,KAAK;GAAS,MAAM,IAAI,GAAG;GAAiB,EAAE,QAAQ;GAAG,OAAO;EAC7G,SAAS,OAAO;CAClB;AACF;AACA,KAAK;AAAM,KAAK;AAAM,KAAK;AAAa,KAAK","names":[],"ignoreList":[],"sources":["derin.ts"],"sourcesContent":["/** Derin sistemlerin sayfaları: Atölye (çekirdek, tarif, ustalık, fuar) ve Semt (takvim, müdavim, esnaf, rakipler, hikâye). */\nimport { cityById } from '../data/turkey';\nimport { PRODUCT } from '../data/catalog';\nimport { fmt, type Result } from '../core/actions';\nimport { dayOf, dateOf } from '../core/calendar';\nimport { ctx, cur, esc, bar, tr, stat, bchips, S as getS, type Helpers } from './panels';\nimport { sfx } from './audio'; import { confetti, ucanYazi } from './juice';\nimport { fincan, cekirdek, barista, muteri, vitrin, rozet, madalya, cadir, latteArt, hareketli } from './art';\nimport { zaferMaddeleri, ZORLUK, D, CEKIRDEKLER, KAVURMA, harman, harmanUyum, cekirdekAyarla, SUTLER, SUPLAR, SOSLAR, tarifMaliyet, tarifTahmin, tarifOlustur, tarifTat, tarifImza, tarifSil, tarifFiyat, YETENEKLER, ustaOf, ustaSeviye, ustaPuan, UNVAN, ustaYetenek, sampiyonaKatil, takvim, mudavimSayi, musteriTipleri, SEG_NOT, esnafOf, esnafIliski, esnafZiyaret, ortakKampanya, kimlik, karakterOf, KARAKTERLER, KISILIK_AD, casusluk, fuarDurum, fuarKayit, SOZLESME, type SozlesmeId, MUD_MAX, type Tarif } from '../core/derin';\n\nconst kisa = (v: number): string => (Math.abs(v) >= 1e6 ? `${tr(v / 1e6)} Mn` : Math.abs(v) >= 1e3 ? `${Math.round(v / 1e3)} B` : String(Math.round(v)));\nconst tf = { ad: '', sut: 0, sup: 1, sos: 0, soguk: false, shot: 1 };\nlet fuarStant: 0 | 1 = 0;\nexport const frSoz = { v: 'standart' as SozlesmeId };\nconst chips = (items: Array<[string, string, boolean]>, a: string, k = ''): string => `<div class=\"chiprow\" style=\"margin:4px 0\">${items.map(([v, ad, on]) => `<button class=\"cx ${on ? 'on' : ''}\" data-a=\"${a}\" data-k=\"${k}\" data-v=\"${v}\">${ad}</button>`).join('')}</div>`;\nconst yildiz = (n: number): string => '★'.repeat(Math.round(n / 20)) + '☆'.repeat(5 - Math.round(n / 20));\n\n\n/* ---------- İpuçları ve mini oyun ---------- */\nconst IPUCU: Record<string, [string, string]> = {\n  cek: ['🫘', 'Kahvenin kalbi çekirdek. Pahalı çekirdek kaliteyi ve yorum puanını yükseltir ama her gün maliyeti artar. İkinci bir çekirdekle harman yap; ✨ işaretli çiftler birbirine uyar.'],\n  tarif: ['🧪', 'Yeni bir içecek tasarla, “Tattır” ile müşteri puanını tahmin et (her tadımda tahmin netleşir), beğenileni imza yap. Soğuklar yazın, sıcaklar kışın satar.'],\n  usta: ['🎓', 'Baristalar her gün deneyim kazanır. Her seviye 1 yetenek puanı verir. Ekim’de şampiyonaya sokup latte art yarışında puan kazandırabilirsin.'],\n  fuar: ['🎪', 'Nisan’da kahve fuarı var. 15 Mart’tan itibaren imza tarifin ya da harmanınla kayıt ol; sunum provasında ne kadar iyi olursan puanın o kadar yükselir.'],\n  takvim: ['📅', 'Bayram, sınav dönemi, derbi, festival… Olay günü “Hazırlan” dersen iyi olay büyür, kötü olay hafifler. Talep yüzdelerine bak.'],\n  mudavim: ['☕', 'Memnun müşteri sadık müdavime dönüşür. Favori ürününü aktif tut ve fiyatını makul bırak; bağı yüksek müdavim hem gelir hem söz yayar.'],\n  esnaf: ['🤝', 'Komşu esnafı ziyaret et, ilişki 40’ı geçince ortak kampanya yapabilirsin. İlişki 60 üstündeyse esnaf sana müşteri yönlendirir.'],\n  rakipler: ['🏢', 'Rakip zincirler şubelerinin olduğu şehirlere girer. Gizli müşteri göndererek güçlerini öğren; agresif olanlar barista kapmaya çalışır.'],\n  hikaye: ['📖', 'Her dükkânın bir kimliği olur. Dönüm noktaları günlüğe yazılır, ekip karakterleri zam, istifa ve kaliteyi etkiler.'],\n};\nfunction ipucuHtml(tab: string): string { const s = getS(), d = D(s), i = IPUCU[tab]; if (!i || d.ipucu[tab]) return ''; return `<div class=\"ipucu2\"><i>${i[0]}</i><div>${i[1]}</div><button class=\"btn sm\" data-a=\"ipucuKapat\" data-t=\"${tab}\">Anladım</button></div>`; }\nconst sar = (tab: string, f: () => string) => (): string => ipucuHtml(tab) + f();\n/** Latte art ritim oyunu: 3 tur, yeşil bölgede dokun. 0–20 bonus verir. */\nexport function miniOyun(baslik: string, bitti: (bonus: number) => void): void {\n  const m = document.createElement('div'); m.className = 'mini'; document.getElementById('app')!.appendChild(m);\n  let tur = 0, puan = 0, raf = 0, zon = 0.4, w = 0.2, x = 0, yon = 1, hiz = 0.9, bitis = false;\n  const ciz = (): void => { m.innerHTML = `<div class=\"minib\"><div class=\"tiny muted\">${esc(baslik)}</div><h3 style=\"margin:2px 0\">Tur ${Math.min(3, tur + 1)}/3</h3><div class=\"artbox\" style=\"margin:6px auto;width:150px\">${latteArt(puan / 60, 140)}</div><div class=\"pist\"><div class=\"zon\" style=\"left:${zon * 100}%;width:${w * 100}%\"></div><div class=\"im\" id=\"im\" style=\"left:${x * 100}%\"></div></div><div class=\"chiprow\" style=\"justify-content:center\"><button class=\"ybtn\" id=\"mDok\" style=\"min-width:140px\">☕ Dök!</button><button class=\"btn sm\" id=\"mAtla\">Atla</button></div><div class=\"tiny muted\" style=\"margin-top:6px\">Sarı işaret yeşil bölgedeyken dokun. Puan: <b>${Math.round(puan / 3)}</b>/20</div></div>`; (m.querySelector('#mDok') as HTMLElement).onclick = dok; (m.querySelector('#mAtla') as HTMLElement).onclick = () => son(0); };\n  const son = (b: number): void => { if (bitis) return; bitis = true; cancelAnimationFrame(raf); m.remove(); bitti(b); };\n  const dok = (): void => { if (bitis) return; const c = x - 0.01, mer = zon + w / 2, uz = Math.abs(c + 0.005 - mer), sk = Math.max(0, 1 - uz / (w * 0.9 + 0.05)) * 20; puan += sk; (sk > 12 ? sfx.dogru : sk > 4 ? sfx.coin : sfx.yanlis)(); ucanYazi(sk > 12 ? 'Harika!' : sk > 4 ? 'İyi' : 'Kaçtı', innerWidth / 2, innerHeight / 2 - 40, sk > 12 ? '#4fd6a8' : sk > 4 ? '#ffd45c' : '#ef6b63'); tur++; if (tur >= 3) { raf && cancelAnimationFrame(raf); const b = Math.round(puan / 3); m.querySelector('.minib')!.innerHTML = `<h3>${b >= 14 ? '🎉 Harika sunum!' : b >= 7 ? '👍 Fena değil' : '😅 Biraz titredi'}</h3><div class=\"artbox\" style=\"margin:6px auto;width:150px\">${latteArt(b / 20, 140)}</div><div class=\"para sm\">${b} / 20 puan</div><button class=\"ybtn\" id=\"mT\" style=\"margin-top:8px\">Tamam</button>`; bitis = false; (m.querySelector('#mT') as HTMLElement).onclick = () => { bitis = false; son(b); }; if (b >= 14) confetti(40); return; } zon = 0.1 + Math.random() * 0.6; w = Math.max(0.1, 0.2 - tur * 0.04); hiz += 0.35; ciz(); };\n  ciz(); let son_t = performance.now();\n  const adim = (t: number): void => { const dt = Math.min(0.05, (t - son_t) / 1000); son_t = t; x += yon * hiz * dt; if (x >= 1) { x = 1; yon = -1; } else if (x <= 0) { x = 0; yon = 1; } const im = m.querySelector<HTMLElement>('#im'); if (im) im.style.left = `${x * 100}%`; if (!bitis || tur < 3) raf = requestAnimationFrame(adim); };\n  raf = requestAnimationFrame(adim);\n}\nexport function zaferHtml(): string {\n  const s = getS(), d = D(s), l = zaferMaddeleri(s), yuzde = Math.round(l.reduce((a, m) => a + Math.min(1, m.v / m.h), 0) / l.length * 100), kisa2 = (v: number): string => (v >= 1e6 ? `${tr(v / 1e6)} Mn` : String(Math.round(v)));\n  return `<div class=\"cardx zafer\"><div class=\"row\"><b>${hareketli('👑')} Kahve İmparatoru yolu</b><span class=\"pill\">%${yuzde}</span></div>${bar(yuzde, 'linear-gradient(90deg,#ffd45c,#e3874a)')}<div class=\"pm\">${l.map((m) => `<div class=\"${m.v >= m.h ? 'tm' : ''}\"><small>${m.ad}</small><b>${m.v >= m.h ? '✓ ' : ''}${kisa2(m.v)} / ${kisa2(m.h)}</b></div>`).join('')}</div>${d.zafer ? '<div class=\"tiny good\" style=\"margin-top:6px\">👑 İmparatorluk kuruldu! Oyuna devam edebilirsin.</div>' : ''}</div>`;\n}\n\n/* ---------- Atölye ---------- */\nfunction pCek(): string {\n  const s = getS(), d = D(s), h = harman(s), c = d.cek, A = CEKIRDEKLER.find((x) => x.id === c.ana)!, K = KAVURMA[c.kavurma]!;\n  const ay = dateOf(dayOf(s)).ay;\n  return `<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx\"><div class=\"tiny muted\">AKTİF KARIŞIM</div><div class=\"art\"><div class=\"artbox\">${cekirdek(c.ana, c.kavurma, 80)}</div><div class=\"artbox\">${fincan({ sut: 3, sup: 0, sos: 0, soguk: false, shot: 2 }, 84)}</div><h3>${esc(c.ad)}</h3></div><div class=\"row small\"><span>Kalite çarpanı</span><b class=\"${h.kal >= 1 ? 'good' : 'badc'}\">×${tr(h.kal, 3)}</b></div><div class=\"row small\"><span>Maliyet çarpanı (kahve malzemesi)</span><b class=\"${h.mal <= 1 ? 'good' : 'badc'}\">×${tr(h.mal, 2)}</b></div><div class=\"row small\"><span>Harman uyumu</span><b class=\"${h.uyum > 0 ? 'good' : h.uyum < 0 ? 'badc' : ''}\">${h.uyum > 0 ? '+' : ''}${tr(h.uyum * 100, 0)} puan</b></div>${c.gecis > 0 ? `<div class=\"tiny badc\">Fırın ısınıyor: ${c.gecis} gün kalite −%3</div>` : ''}<div class=\"small muted\" style=\"margin-top:6px\">${esc(A.not)} · ${K.ad} kavurma: ${K.not}</div><div style=\"display:flex;gap:6px;margin-top:8px\"><input class=\"kin\" id=\"cekAd\" value=\"${esc(c.ad)}\" maxlength=\"24\" style=\"flex:1;margin:0\"><button class=\"btn sm\" data-a=\"cekAd\">Adı kaydet</button></div></div>\n  <div class=\"cardx small muted\">Karışımı değiştirmek 4 B ₺ tutar ve 3 gün geçiş cezası getirir. Hasat mevsiminde ham çekirdek %7 ucuzlar. Kaliteli karışım memnuniyeti ve yorum puanını yükseltir, ama maliyetini her gün ödersin.</div></div>\n  <div class=\"duoR\"><div class=\"cardx\"><b>Ana çekirdek</b>${CEKIRDEKLER.map((x) => `<button class=\"rowb ${c.ana === x.id ? 'fir' : ''}\" data-a=\"cekSet\" data-k=\"ana\" data-v=\"${x.id}\"><i style=\"width:46px;height:40px\">${cekirdek(x.id, c.kavurma, 40)}</i><span><b>${x.ad}</b><small>${x.not} Hasat: ${x.hasat.includes(ay) ? '<b class=\"good\">şimdi</b>' : 'sezon dışı'}</small></span><em>K ${tr(x.kal, 2)} · M ${tr(x.mal, 2)}</em></button>`).join('')}</div>\n  <div class=\"cardx\"><b>İkinci çekirdek (harman)</b>${chips([['yok', 'Yok', !c.ikinci], ...CEKIRDEKLER.filter((x) => x.id !== c.ana).map((x): [string, string, boolean] => [x.id, `${x.ad.split(' ')[0]} ${harmanUyum(c.ana, x.id) > 0 ? '✨' : harmanUyum(c.ana, x.id) < 0 ? '⚠️' : ''}`, c.ikinci === x.id])], 'cekSet', 'ikinci')}${c.ikinci ? `<div class=\"tiny muted\">İkinci çekirdek oranı (en uyumlu: %20–50)</div>${chips([10, 20, 30, 40, 50, 60].map((o): [string, string, boolean] => [String(o / 100), `%${o}`, Math.round(c.oran * 100) === o]), 'cekSet', 'oran')}` : ''}<b style=\"display:block;margin-top:8px\">Kavurma</b>${chips(KAVURMA.map((x, i): [string, string, boolean] => [String(i), x.ad, c.kavurma === i]), 'cekSet', 'kavurma')}</div></div></div>`;\n}\nfunction tarifKart(s: ReturnType<typeof getS>, t: Tarif): string {\n  const d = D(s), e = tarifTahmin(s, t), mal = tarifMaliyet(s, t), imza = d.imza === t.id;\n  return `<div class=\"cardx ${imza ? 'kasa parlak' : ''}\"><div class=\"art\"><div class=\"artbox\">${fincan(t, 66)}</div><div style=\"flex:1\"><div class=\"row\"><b>${imza ? '⭐ ' : ''}${esc(t.ad)}</b><span class=\"pill\">${t.soguk ? '🧊 soğuk' : '🔥 sıcak'}</span></div><div class=\"tiny muted\">${SUTLER[t.sut]} · ${SUPLAR[t.sup]} · ${SOSLAR[t.sos]} · ${t.shot} shot</div></div></div><div class=\"row small\"><span>Müşteri puanı (tahmin)</span><b>${t.test ? `${e.orta}/100 ±${e.pay}` : 'bilinmiyor — tattır'}</b></div>${t.test ? bar(e.orta, 'var(--am)') : ''}<div class=\"row small\"><span>Maliyet · satış fiyatı</span><b>${tr(mal, 1)} ₺ · <span class=\"stp\" style=\"display:inline-flex\"><button data-a=\"tarifFiyat\" data-id=\"${t.id}\" data-d=\"-5\">−</button> ${t.fiyat} ₺ <button data-a=\"tarifFiyat\" data-id=\"${t.id}\" data-d=\"5\">+</button></span></b></div>${t.satis > 0 ? `<div class=\"row small\"><span>Satılan · gelir</span><b>${Math.round(t.satis)} adet · ${fmt(t.gelir)}</b></div>` : ''}<div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm\" data-a=\"tarifTat\" data-id=\"${t.id}\">Tattır (${t.test})</button><button class=\"btn sm ${imza ? 'on' : 'pri'}\" data-a=\"tarifImza\" data-id=\"${t.id}\" ${imza ? 'disabled' : ''}>${imza ? 'İmza içecek' : 'İmza yap (8 B ₺)'}</button><button class=\"btn sm bad\" data-a=\"tarifSil\" data-id=\"${t.id}\">Sil</button></div></div>`;\n}\nfunction pTarif(): string {\n  const s = getS(), d = D(s);\n  const form = `<div class=\"cardx\"><div class=\"art\"><div class=\"artbox\">${fincan(tf, 110)}</div><div style=\"flex:1\"><b>Yeni tarif yaz</b><div class=\"tiny muted\">Önizleme seçimlerine göre değişir.</div></div></div><input class=\"kin\" id=\"tarifAd\" placeholder=\"Tarifin adı\" value=\"${esc(tf.ad)}\" maxlength=\"22\"><div class=\"tiny muted\">Süt</div>${chips(SUTLER.map((x, i): [string, string, boolean] => [String(i), x, tf.sut === i]), 'tfSet', 'sut')}<div class=\"tiny muted\">Şurup</div>${chips(SUPLAR.map((x, i): [string, string, boolean] => [String(i), x, tf.sup === i]), 'tfSet', 'sup')}<div class=\"tiny muted\">Sos</div>${chips(SOSLAR.map((x, i): [string, string, boolean] => [String(i), x, tf.sos === i]), 'tfSet', 'sos')}<div class=\"tiny muted\">Servis · shot</div>${chips([['0', '🔥 Sıcak', !tf.soguk], ['1', '🧊 Soğuk', tf.soguk]], 'tfSet', 'soguk')}${chips([['1', '1 shot', tf.shot === 1], ['2', '2 shot', tf.shot === 2]], 'tfSet', 'shot')}<div class=\"row small\"><span>Tahmini maliyet</span><b>${tr(tarifMaliyet(s, tf), 1)} ₺</b></div><button class=\"ybtn big\" data-a=\"tarifYeni\">Tarifi yaz<small>−${fmt(2500 * s.market.fiyat)}</small></button></div>`;\n  return `<div class=\"duo\"><div class=\"duoL\">${d.tarif.map((t) => tarifKart(s, t)).join('') || '<div class=\"cardx small muted\">Henüz tarifin yok. Sağdan içecek tasarla; tattırarak müşteri puanını tahmin et, beğenileni imza içecek yap.</div>'}</div><div class=\"duoR\">${form}<div class=\"cardx small muted\">Gizli beğeni; her tadımda tahmin netleşir. Soğuk içecekler yazın, sıcaklar kışın çok satar. İmza içecek her şubede ek satış yaratır ve fuarda yarışır.</div></div></div>`;\n}\nfunction pUsta(): string {\n  const s = getS(), b = cur(), d = D(s), ekim = dateOf(dayOf(s)).ay === 9, yil = dateOf(dayOf(s)).yil;\n  const bar_ = b.staff.filter((e) => e.tip === 'barista');\n  const kart = bar_.map((e) => { const u = ustaOf(s, e), sv = ustaSeviye(u), k = karakterOf(s, e); return `<div class=\"cardx\"><div class=\"art\"><div class=\"artbox\" style=\"width:84px\">${barista(e.gorunum ?? e.id, sv, 70)}</div><div style=\"flex:1\"><div class=\"row\"><b>${esc(e.ad)}</b><span class=\"pill\">${UNVAN(sv)} · ${sv}. seviye</span></div><div class=\"tiny muted\">${k.ik} ${k.ad} — ${k.not}</div>${bar(u.xp / 256 * 100, 'var(--am)')}</div></div><div class=\"tiny muted\">Deneyim ${Math.round(u.xp)} · harcanabilir puan <b>${ustaPuan(u)}</b></div>${YETENEKLER.map((y) => `<div class=\"row small\"><span>${y.ad} <span class=\"tiny muted\">(${y.ac})</span></span><b>${'●'.repeat(u[y.id])}${'○'.repeat(5 - u[y.id])} <button class=\"btn sm\" data-a=\"ustaYet\" data-id=\"${e.id}\" data-y=\"${y.id}\">+</button></b></div>`).join('')}<button class=\"btn sm ${ekim ? 'pri' : ''}\" data-a=\"samKatil\" data-id=\"${e.id}\" style=\"margin-top:6px\">🏆 Şampiyonaya sok (8 B ₺)</button></div>`; }).join('');\n  return `${bchips()}<div class=\"duo\"><div class=\"duoL\">${kart || '<div class=\"cardx small muted\">Bu şubede barista yok. Personel sayfasından işe al.</div>'}</div><div class=\"duoR\"><div class=\"cardx\"><b>${hareketli('🏆')} Barista şampiyonası</b><div class=\"tiny muted\">Her yıl Ekim ayında. ${ekim ? '<b class=\"good\">Bu ay kayıt açık!</b>' : 'Ekim ayını bekle.'} (${yil}: ${d.sam.some((x) => x.yil === yil) ? 'katıldın' : 'katılmadın'})</div>${d.sam.map((x) => `<div class=\"row small\"><span>${x.yil}</span><b>${x.derece <= 3 ? madalya(x.derece, 22) : ''} ${esc(x.ad)}</b></div>`).join('') || '<div class=\"tiny muted\">Geçmiş sonuç yok.</div>'}</div><div class=\"cardx small muted\">Barista her gün deneyim kazanır. Her seviye 1 yetenek puanı verir. Latte art ürün kalitesini, sohbet talebi, israfsız çalışma malzeme giderini iyileştirir. Hırslı karakterler daha hızlı gelişir. Şampiyon barista markana prestij ve 2 ay talep artışı getirir.</div></div></div>`;\n}\nfunction pFuar(): string {\n  const s = getS(), d = D(s), du = fuarDurum(s), h = harman(s), imza = d.tarif.find((x) => x.id === d.imza), kayitli = d.fuar.kayit?.yil === du.yil;\n  const asama = du.asama === 'fuar' ? '🎪 Fuar bugün açık!' : du.asama === 'kayit' ? `📝 Kayıt açık — fuara ${du.kalan} gün` : `⏳ Fuara ${du.kalan} gün (Nisan 10–12), kayıt 15 Mart'ta`;\n  return `<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx kasa\"><div class=\"art\"><div class=\"artbox\">${cadir(110)}</div><div><div class=\"tiny muted\">ULUSAL KAHVE FUARI</div><h3>${asama}</h3></div></div>${kayitli ? `<div class=\"small good\">✓ Kayıtlısın: ${esc(d.fuar.kayit!.ad)} (${d.fuar.kayit!.tur === 'tarif' ? 'imza tarif' : 'harman'}) · ${d.fuar.kayit!.stant ? 'büyük stant' : 'küçük stant'}</div>` : du.asama === 'kayit' ? `<div class=\"tiny muted\">Ne ile yarışacaksın?</div><div class=\"chiprow\"><button class=\"btn sm\" data-a=\"fuarStant\" data-v=\"0\">${fuarStant === 0 ? '✓ ' : ''}Küçük stant (6 B)</button><button class=\"btn sm\" data-a=\"fuarStant\" data-v=\"1\">${fuarStant === 1 ? '✓ ' : ''}Büyük stant (15 B)</button></div><div class=\"chiprow\" style=\"margin-top:6px\"><button class=\"btn sm pri\" data-a=\"fuarKayit\" data-t=\"tarif\" ${imza ? '' : 'disabled'}>İmza tarif: ${imza ? esc(imza.ad) : 'yok'}</button><button class=\"btn sm pri\" data-a=\"fuarKayit\" data-t=\"harman\">Harman: ${esc(h.ad)}</button></div>` : '<div class=\"small muted\">Kayıt dönemi dışında. Önceden imza içecek ve harmanını hazırla.</div>'}</div><div class=\"cardx\"><b>🥇 Kupa dolabı</b><div class=\"para sm\">${d.fuar.kupa} altın</div>${d.fuar.gecmis.map((x) => `<div class=\"row small\"><span>${x.yil}</span><b>${madalya(x.derece === 'Altın' ? 1 : x.derece === 'Gümüş' ? 2 : x.derece === 'Bronz' ? 3 : 4, 26)} ${x.derece}</b></div>`).join('') || '<div class=\"tiny muted\">Henüz fuara katılmadın.</div>'}</div></div><div class=\"duoR\"><div class=\"cardx small muted\"><b>Puan nasıl hesaplanır?</b><br>Ürün kalitesi (imza tarifin müşteri puanı ya da harman kalitesi) %70, barista latte art ustalığı, marka puanın ve stant büyüklüğü eklenir. Rakip zincirler de yarışır; güçlenen rakip zor rakip demektir.<br><br>Altın: 50 B ₺ + marka +8 + 45 gün talep +%10 · Gümüş: 25 B ₺ + marka +5 · Bronz: 10 B ₺ + marka +3. Stant satışları ayrıca etkinlik geliri olarak yazılır.</div></div></div>`;\n}\n\n/* ---------- Semt ---------- */\nfunction pTakvim(): string {\n  const s = getS(), b = cur(), k = kimlik(s, b), tk = takvim(s, b, 14), now = dayOf(s);\n  return `${bchips()}<div class=\"cardx\"><div class=\"row\"><b>${hareketli(k.ik)} ${esc(b.ad)}</b><span class=\"pill\">${k.ad}</span></div><div class=\"tiny muted\">Yaklaşan semt olayları ve talebe etkileri. Olay günü sana hazırlık sorulur.</div></div><div class=\"rows\">${tk.map((x) => { const dt = dateOf(x.gun); return `<div class=\"rowb ${x.olaylar.length ? 'fir' : ''}\"><i>${x.olaylar[0] ? hareketli(x.olaylar[0].ikon) : '·'}</i><span><b>${x.gun === now ? 'Bugün' : `${dt.ayGun} ${dt.ayAdi}`}</b><small>${x.olaylar.map((o) => `${o.ad} ${o.talep >= 1 ? '+' : ''}${Math.round((o.talep - 1) * 100)}%`).join(' · ') || 'Normal gün'}</small></span></div>`; }).join('')}</div>`;\n}\nfunction pMudavim(): string {\n  const s = getS(), b = cur(), d = D(s), l = d.mud[b.id] ?? [], tip = musteriTipleri(b);\n  return `${bchips()}<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx\"><b>👥 Müşteri tipleri</b>${tip.map((x) => `<div class=\"row small\"><span><b>${x.ad}</b> %${Math.round(x.pay * 100)}</span></div>${bar(x.pay * 100, 'var(--am)')}<di