p((r) => { const goz = now - r.casus <= 20; return `<div class=\"cardx\"><div class=\"art\"><div class=\"artbox\" style=\"width:70px\">${rozet(r.ad, r.kisilik, 56)}</div><div style=\"flex:1\"><div class=\"row\"><b>${esc(r.ad)}</b><span class=\"pill\">${KISILIK_AD[r.kisilik]}</span></div><div class=\"tiny muted\">“${esc(r.slogan)}”</div></div></div><div class=\"row small\"><span>Şehir sayısı</span><b>${r.sehirler.length}${r.sehirler.length ? ' · ' + r.sehirler.slice(0, 4).map((c) => cityById(c).ad).join(', ') : ''}</b></div><div class=\"row small\"><span>Güç</span><b>${goz ? tr(r.guc, 2) : '??'}</b></div><div class=\"small muted\">Son hamle: ${esc(r.son)}</div>${goz ? '<div class=\"tiny good\">Gizli müşteri raporu aktif (20 gün)</div>' : ''}<button class=\"btn sm\" data-a=\"casus\" data-id=\"${r.id}\" style=\"margin-top:6px\">Gizli müşteri gönder (6 B)</button></div>`; }).join('')}</div><div class=\"cardx small muted\">Zincirler zamanla şubelerinin olduğu şehirlere girer. Agresif olan fiyat kırar ve barista kapmaya çalışır; kalite odaklı olan fuarda yarışır. Fuarda güçlenen rakip altın madalya için zor rakiptir.</div>`;\n}\nfunction pHikaye(): string {\n  const s = getS(), b = cur(), d = D(s), k = kimlik(s, b), l = d.hik[b.id] ?? [], g = d.hik[0] ?? [];\n  return `${bchips()}<div class=\"duo\"><div class=\"duoL\"><div class=\"cardx\"><div class=\"tiny muted\">DÜKKÂNIN KİMLİĞİ</div><h3>${hareketli(k.ik)} ${k.ad}</h3><div class=\"small muted\">${esc(b.ad)} · ${cityById(b.city).ad} · ${Math.max(0, dayOf(s) - b.acilis)} gündür açık</div></div><div class=\"cardx\"><b>⭐ Dükkân günlüğü</b>${l.map((x) => `<div class=\"small\" style=\"padding:4px 0;border-top:1px solid var(--line)\">${esc(x)}</div>`).join('') || '<div class=\"small muted\">Henüz kayıt yok; ilk müşteriler gelsin…</div>'}</div></div><div class=\"duoR\"><div class=\"cardx\"><b>👥 Ekibin karakterleri</b>${b.staff.map((e) => { const kr = karakterOf(s, e); return `<div class=\"row small\"><span>${kr.ik} ${esc(e.ad)}</span><b>${kr.ad}</b></div><div class=\"tiny muted\">${kr.not}</div>`; }).join('') || '<div class=\"small muted\">Ekip yok.</div>'}<div class=\"tiny muted\" style=\"margin-top:6px\">${KARAKTERLER.length} karakter türü var; zam isteği, istifa ve kalite etkileri karaktere göre değişir.</div></div><div class=\"cardx\"><b>📰 Şirket günlüğü</b>${g.slice(0, 10).map((x) => `<div class=\"small\" style=\"padding:3px 0;border-top:1px solid var(--line)\">${esc(x)}</div>`).join('') || '<div class=\"small muted\">Henüz haber yok.</div>'}</div></div></div>`;\n}\nexport const DERIN_PAGES: Record<string, () => string> = { cek: sar('cek', pCek), tarif: sar('tarif', pTarif), usta: sar('usta', pUsta), fuar: sar('fuar', pFuar), takvim: sar('takvim', pTakvim), mudavim: sar('mudavim', pMudavim), esnaf: sar('esnaf', pEsnaf), rakipler: sar('rakipler', pRakipler), hikaye: sar('hikaye', pHikaye) };\n\n/* ---------- Franchise sözleşme seçici ---------- */\nexport function sozlesmeHtml(): string {\n  return `<div class=\"tiny muted\" style=\"margin-top:6px\">Sözleşme türü</div><div class=\"chiprow\" style=\"margin:4px 0\">${(Object.keys(SOZLESME) as SozlesmeId[]).map((id) => `<button class=\"cx ${frSoz.v === id ? 'on' : ''}\" data-a=\"frsoz\" data-v=\"${id}\">${SOZLESME[id].ad}</button>`).join('')}</div><div class=\"tiny muted\">${SOZLESME[frSoz.v].ac} (Royalty %${Math.round(SOZLESME[frSoz.v].royalty * 100)} + pazarlama %${Math.round(SOZLESME[frSoz.v].pazarlama * 100)})</div>`;\n}\n\n/* ---------- Eylemler ---------- */\nexport function handleDerin(a: string, dd: DOMStringMap, h: Helpers): boolean {\n  const s = getS(), b = ctx.S ? cur() : null; const R = (r: Result): boolean => { h.res(r); h.refresh(); return true; };\n  const num = (k: string | undefined): number => +(k ?? 0);\n  switch (a) {\n    case 'cekSet': { const k = dd.k!, v = dd.v!; return R(cekirdekAyarla(s, k === 'ana' ? { ana: v } : k === 'ikinci' ? { ikinci: v === 'yok' ? null : v } : k === 'oran' ? { oran: +v } : { kavurma: +v as 0 | 1 | 2 })); }\n    case 'cekAd': { const el = document.getElementById('cekAd') as HTMLInputElement | null; return R(cekirdekAyarla(s, { ad: el?.value ?? '' })); }\n    case 'tfSet': { const k = dd.k as 'sut' | 'sup' | 'sos' | 'soguk' | 'shot', el = document.getElementById('tarifAd') as HTMLInputElement | null; if (el) tf.ad = el.value; if (k === 'soguk') tf.soguk = dd.v === '1'; else tf[k] = +dd.v!; h.refresh(); return true; }\n    case 'tarifYeni': { const el = document.getElementById('tarifAd') as HTMLInputElement | null; const r = tarifOlustur(s, el?.value || tf.ad, { sut: tf.sut, sup: tf.sup, sos: tf.sos, soguk: tf.soguk, shot: tf.shot }); if (r.ok) tf.ad = ''; return R(r); }\n    case 'tarifTat': return R(tarifTat(s, num(dd.id))); case 'tarifImza': return R(tarifImza(s, num(dd.id))); case 'tarifSil': return R(tarifSil(s, num(dd.id))); case 'tarifFiyat': return R(tarifFiyat(s, num(dd.id), num(dd.d)));\n    case 'ustaYet': return R(ustaYetenek(s, num(dd.id), dd.y as 'art' | 'sohbet' | 'tasarruf'));\n    case 'samKatil': { const id = num(dd.id); if (dateOf(dayOf(s)).ay !== 9) return R(sampiyonaKatil(s, id)); miniOyun('Barista şampiyonası: latte art finali', (bn) => { const r = sampiyonaKatil(s, id, bn); h.res(r); if (r.ok && /madalya/.test(r.m)) { sfx.madalya(); confetti(110); } h.refresh(); }); return true; }\n    case 'ipucuKapat': D(s).ipucu[dd.t!] = 1; h.refresh(); return true;\n    case 'fuarStant': fuarStant = dd.v === '1' ? 1 : 0; h.refresh(); return true; case 'fuarKayit': { const tur = dd.t as 'tarif' | 'harman'; miniOyun('Fuar standı: sunum provası', (bn) => { h.res(fuarKayit(s, tur, fuarStant, bn)); h.refresh(); }); return true; }\n    case 'esnafZiyaret': return b ? R(esnafZiyaret(s, b, dd.id!)) : true; case 'esnafOrtak': return b ? R(ortakKampanya(s, b, dd.id!)) : true;\n    case 'casus': return R(casusluk(s, dd.id!)); case 'frsoz': frSoz.v = dd.v as SozlesmeId; h.refresh(); return true;\n    default: return false;\n  }\n}\nvoid stat; void kisa; void mudavimSayi; void yildiz;\n"],"file":"/src/ui/derin.ts"}